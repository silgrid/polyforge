{
  "name": "w25-npm-range",
  "typescript": "^5",
  "scripts": {
    "postinstall": "patch-package && node bin/prepare-terminal.js",
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node --experimental-strip-types e2e/run.mjs",
    "test": "node scripts/tmp-guard.mjs node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  }
}
