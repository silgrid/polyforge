#!/bin/sh
# Stub npm for the audit-deps unit tests: records its arguments and replays a
# recorded `npm audit --json` report. W320_NPM_OUT names the stdout file,
# W320_NPM_ERR an optional stderr file, W320_NPM_RC the exit status. A run
# that drops dev dependencies (--omit=dev) answers W320_NPM_PROD_OUT when
# it names a file (the production-tree audit a declared --npm-prod-level
# runs), else an empty report, so a helper that narrowed the whole-tree run
# would turn a dev-only finding green.
printf '%s\n' "$*" >>"${W320_STUB_ARGS:-/dev/null}"
case " $* " in
*" config get registry "*) echo https://registry.npmjs.org/; exit 0 ;;
*" --omit=dev "* | *" --omit dev "* | *" --production "*)
	if [ -n "${W320_NPM_PROD_OUT:-}" ]; then
		cat "$W320_NPM_PROD_OUT"
	else
		printf '{"auditReportVersion":2,"vulnerabilities":{},"metadata":{}}\n'
	fi
	exit 0
	;;
esac
cat "$W320_NPM_OUT"
[ -n "${W320_NPM_ERR:-}" ] && cat "$W320_NPM_ERR" >&2
exit "${W320_NPM_RC:-0}"
