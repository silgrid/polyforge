#!/usr/bin/env python3
"""review-firstpass — first-pass review rate by plan write-set size and by implementer.

Usage:
  python3 -I tools/review-firstpass <capsules-dir> [--since YYYY-MM-DD] [--until YYYY-MM-DD] [--csv <file>] [--cohort <manifest.json>]

Read-only over <capsules-dir> (a workspace's capsules/, one directory per work
item run). It prints two tables and, with --csv, writes one row per run.

With --cohort it also appends the split-comparison section (polyforge#118):
an owner-confirmed cohort manifest (JSON) groups the collected runs —

  {"version": "<the cohort's daemon/workflow version>",
   "window": {"since": "YYYY-MM-DD", "until": "YYYY-MM-DD"},   // optional; only filters
   "baseline": {"firstpass": {"<=7": "31/38", "8-22": "13/31", ">22": "4/34"},
                 "source": "<where the pinned numbers come from>"},
   "control": ["<capsule dir name>", ...],                      // unsplit runs
   "split": [{"origin": "<wi id>", "epic": "<capsule dir>",
              "children": ["<capsule dir>", ...]}]}            // 原票/子票对应

— and reports each group's first-pass rate beside the plan-size buckets
(a reviewed run with no parseable plan counts `unknown`), the epic
aggregation on its own line (never in the children's denominators), the
pinned baseline verbatim (the #1 background numbers travel in the
manifest, not in this tool), and the honesty lines: a manifest name
absent from the input is counted and listed as missing, a name the
window filtered is listed as filtered (dates only ever filter — the
grouping itself is the manifest's), and a split group with no samples
says N/A, never a fabricated number. Without --cohort the output is
byte-for-byte the pre-cohort report.

The measure is the 2026-11-09 rework baseline's (aihub doc.audit
mem_2wmAvnsWFWmw), kept byte-for-byte where it decides
a number:

  run set      every capsule directory except `*.quarantined.*`; --since/--until
               filter on capsule.json created_at (UTC date, both ends inclusive).
  first pass   the verdict of the lowest-numbered artifacts/steps/review/s<n>/
               result.json (output.verdict, else the outcome); a run with no
               review result is not reviewed and counts nowhere.
  write set    the distinct paths artifacts/plan.md declares `(write)` in its
               `Touched files` blocks, counted before any code: on the develop
               lane only the units of the lowest-numbered build result (its
               initial plan; every unit when that result lists none). A run
               without a parseable plan has no write set and stays out of the
               size table (the baseline's plan-declared, ex-ante size).
  buckets      <=7, 8-22, >22 written files.

The implementer grouping reads the build result the first
review judged — the highest-numbered artifacts/steps/build/s<m>/result.json
with m below the first review's n — and its units' implemented_by: `subagent`
when every unit says subagent, `main` when every unit says main, `mixed` for
both, `unrecorded` when no unit records one (runs before the field, and lanes
whose build reports no units).
"""
import argparse
import csv
import glob
import json
import os
import re
import statistics
import sys

BUCKETS = (('<=7', 0, 7), ('8-22', 8, 22), ('>22', 23, None))
IMPLEMENTERS = ('main', 'subagent', 'mixed', 'unrecorded')


def jload(p):
    try:
        with open(p) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def runs_of(cap, step):
    """[(n, result)] of artifacts/steps/<step>/s<n>/result.json, by n."""
    out = []
    for f in glob.glob(os.path.join(cap, 'artifacts', 'steps', step, 's*', 'result.json')):
        m = re.search(r'/s(\d+)/result\.json$', f)
        if m:
            out.append((int(m.group(1)), jload(f) or {}))
    return sorted(out, key=lambda x: x[0])


# ---------------------------------------------------------------- plan.md write set
# The baseline's parser, unchanged: one entry per `Touched files` block, keyed by
# the nearest preceding `###` unit heading.
UNIT_HEAD = re.compile(r'^###\s+(\S+?)\s*(?:—|-|:|$)')
TOUCH = re.compile(r'touched files', re.I)
PATHRX = re.compile(r'`?([A-Za-z0-9_.@\-/\[\]{}*,]+?)`?\s*\((write|read)\b')
BLOCK_END = re.compile(r'^\s*$|^\s*- |^\s*#|^\s*\*\*|^\s*\d+\.\s')


def parse_plan(path):
    """-> [[unit_id, [(path, mode)]]], one entry per Touched-files block."""
    with open(path, errors='replace') as f:
        lines = f.read().split('\n')
    units, head, i = [], None, 0
    while i < len(lines):
        ln = lines[i]
        m = UNIT_HEAD.match(ln)
        if m:
            head = m.group(1)
        elif ln.startswith('## '):
            head = None
        t = TOUCH.search(ln)
        if t:
            buf = [ln[t.end():]]
            j = i + 1
            while j < len(lines) and not BLOCK_END.match(lines[j]):
                buf.append(lines[j])
                j += 1
            ps = []
            for p, mode in PATHRX.findall(' '.join(buf)):
                p = p.strip('`,')
                if p.startswith('./'):
                    p = p[2:]
                if '/' in p or '.' in p:
                    ps.append((p, mode))
            if ps:
                units.append([head or f'blk{len(units) + 1}', ps])
            i = j
            continue
        i += 1
    return units


def written_files(cap, lane, builds):
    plan = os.path.join(cap, 'artifacts', 'plan.md')
    if not os.path.exists(plan):
        return None
    units = [u for u in parse_plan(plan) if u[1]]
    if lane == 'develop' and builds:
        first = (builds[0][1].get('output') or {}).get('units') or []
        init_ids = {u.get('id') for u in first if isinstance(u, dict)}
        if init_ids:
            units = [u for u in units if u[0] in init_ids] or units
    if not units:
        return None
    return len({p for _, ps in units for p, mode in ps if mode == 'write'})


def implementer(builds, first_review):
    judged = [r for n, r in builds if n < first_review]
    if not judged:
        return 'unrecorded'
    units = (judged[-1].get('output') or {}).get('units') or []
    by = {u.get('implemented_by') for u in units if isinstance(u, dict)} & {'main', 'subagent'}
    if not by:
        return 'unrecorded'
    return by.pop() if len(by) == 1 else 'mixed'


def bucket(n):
    for name, lo, hi in BUCKETS:
        if n >= lo and (hi is None or n <= hi):
            return name
    return None


def collect(caps_dir, since, until):
    rows, quarantined = [], 0
    for name in sorted(os.listdir(caps_dir)):
        cap = os.path.join(caps_dir, name)
        if not os.path.isdir(cap):
            continue
        if '.quarantined.' in name:
            quarantined += 1
            continue
        cj = jload(os.path.join(cap, 'capsule.json')) or {}
        created = (cj.get('created_at') or '')[:10]
        if (since and (not created or created < since)) or (until and (not created or created > until)):
            continue
        lane = cj.get('bundle_name') or '?'
        reviews = runs_of(cap, 'review')
        row = {'capsule': name, 'lane': lane, 'created': created, 'review_runs': len(reviews),
               'first_review': '', 'written_files': '', 'bucket': '', 'implementer': ''}
        if reviews:
            n, r = reviews[0]
            row['first_review'] = ((r.get('output') or {}).get('verdict') or r.get('outcome') or '?').upper()
            builds = runs_of(cap, 'build')
            row['implementer'] = implementer(builds, n)
            w = written_files(cap, lane, builds)
            if w is not None:
                row['written_files'] = w
                row['bucket'] = bucket(w)
        rows.append(row)
    return rows, quarantined


def first_pass(rs):
    judged = [r for r in rs if r['first_review'] in ('PASS', 'FAIL')]
    return sum(1 for r in judged if r['first_review'] == 'PASS'), len(judged)


def line(label, rs):
    ok, n = first_pass(rs)
    rate = f'{100 * ok / n:.0f}%' if n else '-'
    med = f"{statistics.median([r['review_runs'] for r in rs]):g}" if rs else '-'
    return f'{label:<24} {len(rs):>4}  {f"{ok}/{n}":>10}  {rate:>5}  {med:>7}'


# ---------------------------------------------------------------- cohort view
# The owner-confirmed split comparison (polyforge#118): the manifest IS
# the grouping; dates only filter. Every honesty rule below answers a
# ruled decision of the work item (Q2: 未拆票作对照、子票作拆后组、epic 聚合
# 另列；Q5: 缺样本如实标 N/A，不拿演示输出冒充真实比较)。

def jload_strict(path, what):
    try:
        with open(path) as f:
            v = json.load(f)
    except (OSError, ValueError) as e:
        print(f'review-firstpass: {what}: {e}', file=sys.stderr)
        sys.exit(2)
    if not isinstance(v, dict):
        print(f'review-firstpass: {what}: not a JSON object', file=sys.stderr)
        sys.exit(2)
    return v


def cohort_names(manifest, key):
    v = manifest.get(key, [])
    if not isinstance(v, list) or any(not isinstance(x, str) for x in v):
        print(f'review-firstpass: the cohort manifest’s {key} must be a list of capsule dir names', file=sys.stderr)
        sys.exit(2)
    return v


def cohort_split(manifest):
    out = []
    v = manifest.get('split', [])
    if not isinstance(v, list):
        print('review-firstpass: the cohort manifest’s split must be a list', file=sys.stderr)
        sys.exit(2)
    for e in v:
        if not isinstance(e, dict) or not isinstance(e.get('children'), list) \
                or any(not isinstance(x, str) for x in e['children']) \
                or not isinstance(e.get('origin', ''), str) \
                or not isinstance(e.get('epic', ''), str):
            print('review-firstpass: every split entry needs origin (str), children (list of capsule dir names) and epic (str)', file=sys.stderr)
            sys.exit(2)
        out.append(e)
    return out


def cohort_group_line(label, rs, empty_note=''):
    judged = [r for r in rs if r['first_review'] in ('PASS', 'FAIL')]
    ok = sum(1 for r in judged if r['first_review'] == 'PASS')
    parts = []
    for name, _, _ in BUCKETS:
        b = [r for r in judged if r['bucket'] == name]
        parts.append(f'{name} {sum(1 for r in b if r["first_review"] == "PASS")}/{len(b)}')
    unk = sum(1 for r in judged if not r['bucket'])
    parts.append(f'unknown {unk}')
    sizes = ', '.join(parts)
    if judged:
        fp = f'first-pass {ok}/{len(judged)} ({100 * ok / len(judged):.0f}%)'
    else:
        fp = f'first-pass N/A (0 samples{empty_note})'
    return f'{label}: {len(rs)} runs ({len(judged)} reviewed), {fp}, plan sizes {sizes}'


def report(rows, quarantined, out=sys.stdout):
    reviewed = [r for r in rows if r['review_runs']]
    sized = [r for r in reviewed if r['bucket']]
    p = lambda s='': print(s, file=out)
    p(f'runs={len(rows)} quarantined(skipped)={quarantined} reviewed={len(reviewed)} '
      f'sized(plan-declared write set)={len(sized)}')
    head = f'{"":<24} {"N":>4}  {"first-pass":>10}  {"rate":>5}  {"med_rev":>7}'
    p()
    p('== first-pass review by plan write set (written files)')
    p(head)
    for name, _, _ in BUCKETS:
        p(line(name, [r for r in sized if r['bucket'] == name]))
    p()
    p('== by implementer (implemented_by of the build the first review judged) x write set')
    p(head)
    for who in IMPLEMENTERS:
        group = [r for r in sized if r['implementer'] == who]
        if not group:
            continue
        p(line(who, group))
        for name, _, _ in BUCKETS:
            g = [r for r in group if r['bucket'] == name]
            if g:
                p(line(f'  {name}', g))


def cohort_report(rows, caps_dir, manifest, path, out=sys.stdout):
    """The split comparison (polyforge#118): per-group first-pass beside
    the plan-size buckets, the pinned baseline verbatim, and the honesty
    lines — missing, filtered, and the empty split group's N/A."""
    p = lambda s='': print(s, file=out)
    win = manifest.get('window') or {}
    if not isinstance(win, dict):
        print('review-firstpass: the cohort manifest’s window must be an object', file=sys.stderr)
        sys.exit(2)
    since, until = win.get('since', ''), win.get('until', '')
    window = f'{since}..{until}' if (since or until) else 'none'
    p()
    p(f'== cohort comparison (manifest: {os.path.basename(path)}, version: {manifest.get("version", "unknown")}, window: {window}) ==')
    base = manifest.get('baseline')
    if isinstance(base, dict) and isinstance(base.get('firstpass'), dict):
        fp = base['firstpass']
        p(f'baseline (pinned #1 background, source: {base.get("source", "unamed")}): '
          f'first-pass <=7 {fp.get("<=7", "?")}, 8-22 {fp.get("8-22", "?")}, >22 {fp.get(">22", "?")}')

    by_name = {r['capsule']: r for r in rows}
    splits = cohort_split(manifest)
    children = [c for e in splits for c in e['children']]
    epics = [e['epic'] for e in splits if e.get('epic')]
    control = cohort_names(manifest, 'control')

    def group(names, label, empty_note=''):
        p(cohort_group_line(label, [by_name[n] for n in names if n in by_name], empty_note))

    group(control, 'control (unsplit runs)')
    group(children, 'split children', ' - no epic run has completed yet' if not splits else '')
    group(epics, 'split epics (listed apart)')

    # the honesty lines: a manifest name the collect did not return is
    # either filtered by the window (it IS in the input) or missing.
    missing, filtered = [], []
    for n in control + children + epics:
        if n in by_name:
            continue
        cap = os.path.join(caps_dir, n)
        cj = jload(os.path.join(cap, 'capsule.json')) or {}
        created = (cj.get('created_at') or '')[:10]
        if os.path.isdir(cap) and created and \
                not (since and (not created or created < since)) and \
                not (until and (not created or created > until)):
            continue  # the CLI flags (not the window) filtered it
        if os.path.isdir(cap) and (since or until):
            filtered.append(n)
        else:
            missing.append(n)
    if filtered:
        p(f'outside the manifest window (filtered): {", ".join(filtered)} ({len(filtered)})')
    if missing:
        p(f'missing from the input (counted, excluded): {", ".join(missing)} ({len(missing)})')


def main(argv):
    ap = argparse.ArgumentParser(prog='review-firstpass', description=__doc__.split('\n')[0])
    ap.add_argument('capsules_dir')
    ap.add_argument('--since', help='first capsule.json created_at date (YYYY-MM-DD), inclusive')
    ap.add_argument('--until', help='last capsule.json created_at date (YYYY-MM-DD), inclusive')
    ap.add_argument('--csv', help='write one row per run to this file')
    ap.add_argument('--cohort', help='an owner-confirmed cohort manifest (JSON): the split-comparison grouping')
    a = ap.parse_args(argv)
    if not os.path.isdir(a.capsules_dir):
        print(f'review-firstpass: {a.capsules_dir} is not a directory', file=sys.stderr)
        return 2
    manifest, cohort_path = None, None
    since, until = a.since, a.until
    if a.cohort:
        cohort_path = a.cohort
        manifest = jload_strict(a.cohort, a.cohort)
        win = manifest.get('window') or {}
        if not isinstance(win, dict):
            print('review-firstpass: the cohort manifest’s window must be an object', file=sys.stderr)
            return 2
        # the window only filters, like the flags: both apply, intersected
        def _later(x, y):
            return x if (not y or (x and x >= y)) else y

        def _earlier(x, y):
            return x if (not y or (x and x <= y)) else y

        since = _later(since, win.get('since', ''))
        until = _earlier(until, win.get('until', ''))
    rows, quarantined = collect(a.capsules_dir, since, until)
    if a.csv:
        with open(a.csv, 'w', newline='') as f:
            w = csv.DictWriter(f, fieldnames=list(rows[0]) if rows else ['capsule'])
            w.writeheader()
            w.writerows(rows)
    report(rows, quarantined)
    if manifest is not None:
        cohort_report(rows, a.capsules_dir, manifest, cohort_path)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
