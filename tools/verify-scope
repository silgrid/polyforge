#!/bin/sh
# verify-scope — release-shipped verification-scope reporter.
#
# Usage:
#   tools/verify-scope [--base <rev>] [--full] [--micro] [--json] [--run]
#
# The report is written on stdout and nothing else. It covers the diff from
# a base revision to HEAD. The default report is line-oriented:
#
#   mode: full|scoped
#   path: <repo-relative path>      one per affected path, sorted, unique
#   command: <command>              the commands to run, in the fixed order
#
# `--json` replaces the line report with exactly one JSON object (`schema: 1`,
# the contract in docs/contributing.md "Verification tiers"): the same mode,
# paths and commands — each command with its name, phase (fast|full|scoped,
# or micro under --micro),
# declared prerequisites, declared timeout (null when none is declared, so
# the consumer's own default applies) and source (conf|default) — plus the
# stack,
# the analyzer, whether the conf is present and whether the diff changed it,
# the resolved base/head shas and default branch, the conf's test_glob,
# base_setup, runner, ci_evidence, e2e_runner, suite_glob and e2e_map
# declarations and every stderr diagnostic; a repository that
# declares smoke_suite= also gets `smoke_suite` and the full-tier e2e
# selection `e2e_selection` (null unless one was attempted; see "Full-tier
# e2e selection" below). The JSON is emitted by python3 (a documented `pf doctor`
# prerequisite); without python3 `--json` exits 1.
#
# `--micro` is the micro lane's evidence mode: the conf is read as it is at
# the diff base (`git show <base>:.polyforge/verify-scope.conf`, never the
# working tree, so a change cannot widen its own declaration; an absent or
# unreadable base conf declares nothing and is diagnosed), `mode` reads
# `micro`, and `commands` is exactly the fast phase followed by the conf's
# micro_check= commands (phase `micro`, named micro-<i> in file order) — no
# scoped or full command. With `--run` those run in order from the
# repository root, stopping at the first non-zero; under `--micro` a missing
# declared prerequisite, a repository that declares no micro_path= at the
# base, or an empty command list is a failure, never a skip.
#
# `--base <rev>` overrides the default base. The default base is
# `git merge-base HEAD origin/<default>`, where <default> is the branch
# `origin/HEAD` points at (fallback `main`). The capsule baseline in
# `capsule.json` is NEVER read. `--full` forces the full tier whatever the
# diff; it never narrows anything (a caller verifying a full-tier work item
# uses it to get the full command list).
#
# The target repository is the current working directory. Diagnostics go to
# stderr. `--run` prints the report and then executes the reported commands
# in order with `bash -c` from the repository root (stdin closed), stopping at
# the first non-zero and exiting non-zero; a command whose declared
# prerequisites (an unset or empty check_requires_env variable, a
# check_requires_cmd executable not on PATH) are missing is skipped with a
# stderr notice, and timeouts are reported, not enforced. Their output goes to
# stderr so stdout keeps the machine-readable shape.
#
# Conf first: the repository's declared commands are reported for every
# stack. Stack detection: go.mod selects the Go analyzer, package.json the
# npm analyzer, pyproject.toml or requirements.txt the python analyzer and
# Cargo.toml the rust analyzer; a `stack=` pin overrides detection and
# `stack=none` pins "no analyzer". With no analyzer — `stack=none`, an
# unsupported stack (no supported manifest), an ambiguous one (two or more
# supported manifests without a pin) or an npm manifest whose scripts cannot
# be read — the report is `mode: full` with the conf's commands only (none
# without a conf). A scope that cannot be computed
# always falls back to `full`, never to a wrong `scoped`.
#
# A repository may declare a declarative `.polyforge/verify-scope.conf`
# (line-oriented; `#` comments and blank lines ignored; a value runs to the
# end of its line, so there is no trailing comment on a value line):
#
#   stack=go|npm|python|rust|none
#                          pin the analyzer; none = conf commands, always full
#   go_harness=<path>      a Go acceptance harness that owns its directory
#   fast_gate=<command>    repeatable, ordered; anonymous, named fast-<i>
#   full_command=<command> repeatable, ordered; anonymous, named full-<i>
#   check=<name>|<fast|full>|<command>
#                          repeatable; a named command of that phase, in file
#                          order among the phase's lines
#   check_requires_env=<name>|VAR[,VAR]  the named command needs these
#                          variables set and non-empty
#   check_requires_cmd=<name>|bin[,bin]  the named command needs these
#                          executables on PATH
#   check_timeout=<name>|<duration>      the named command's timeout, a
#                          positive Go duration (undeclared: null in --json)
#   forced_full=<glob>     repeatable; a path matching it forces the full tier
#   module_root=<path>     repeatable; Go spanning roots
#   exclude=<glob>         repeatable; a path matching it is ignored by the
#                          full-tier triggers and the full standalone npm pass
#   test_glob=<glob>       repeatable; a repo test-file pattern (reported only)
#   base_setup=<command>   repeatable, ordered; the setup a base-tree rerun
#                          needs first (reported only)
#   runner=complete        the conf declares the complete bar (reported only)
#   ci_evidence=<workflow>/<job>  repeatable; a CI job the deliver step may
#                          accept as test evidence (reported only)
#   e2e_runner=<command>   the command that runs selected suites: they are
#                          appended to it as one command, in stable order
#                          (its target file is a runner, never a suite)
#   suite_glob=<glob>      repeatable; replaces the analyzer's suite discovery
#   e2e_map=<glob>=<suite> repeatable; replaces that suite's carries: header
#   smoke_suite=<suite>    repeatable; a repository-relative suite the
#                          full-tier e2e selection always runs; declaring one
#                          opts the repository into that selection
#   micro_path=<glob>      repeatable; a repository-relative path pattern the
#                          micro lane may change (`*` within one path segment,
#                          `**` across `/`, no wildcard = that exact path);
#                          declaring one opts the repository into micro. An
#                          absolute, `./`-prefixed, blank or `..`-escaping
#                          value is diagnosed and contributes nothing
#   micro_check=<command>  repeatable, ordered; an extra micro-lane evidence
#                          command, named micro-<i>, run after the fast phase
#                          only under --micro
#
# A repository that declares micro_path= or micro_check= (or any --micro
# report) gets `micro_paths` and `micro_checks` in --json; one that declares
# neither keeps the report's key set unchanged.
#
# An empty or malformed e2e_runner=, suite_glob=, e2e_map= or smoke_suite=
# value (e2e_map= split by exactly one `=`; smoke_suite= one relative path
# without blanks) is diagnosed and forces the full tier.
#
# Full-tier e2e selection: with --full, at least one smoke_suite= line and a
# non-empty diff, the full tier's e2e phase is not the full tail but the
# carries-selected suites union the smoke suites (`e2e_selection.mode`
# carries), or the smoke suites alone when every changed path is
# documentation or an exclude= match (mode smoke); a changed
# non-documentation path no declaration covers is listed in
# `e2e_selection.uncovered_paths` and does not force the full tail. A
# forced-full match, a change to this conf, or a structural diagnostic (a
# malformed carries or smoke_suite= key, an analyzer without the carries
# layer, an undeclared or malformed suite, an unresolvable import, an
# e2e_map= or smoke_suite= naming no discovered suite, an empty full tail)
# runs the full tail (mode full) and is diagnosed. `mode:` stays the tier
# fact (full), and `e2e_selection.full_commands` always carries the full
# tail, the bar a delivery re-runs. The scoped tier never adds a smoke suite.
#
# Any fast-phase line (fast_gate= or check=<name>|fast|…) replaces the
# analyzer's default fast gates, and any full-phase line replaces the default
# full tail; the anonymous lines are numbered per phase from 1 in file order.
# A check name is letters, digits, `.`, `_` and `-`, starts with a letter or
# digit, is declared once, and never has the form fast-<n>, full-<n>,
# scoped-<n> or micro-<n> (the anonymous and analyzer commands' names). A check_* line
# names a declared conf command (a check= name, or fast-<i>/full-<i>/micro-<i>); a
# line naming none is diagnosed and ignored, as is a malformed one.
#
# The conf is declarative: it is never sourced or evaluated at parse time and
# it has no hook-style keys (pre/post/exec); an unknown key is diagnosed and
# contributes nothing. A command value is an opaque string: it is reported as a
# `command:` line and, only with --run, executed by `bash -c` (command values
# are bash), with the same trust as the repository's own Makefile. A command
# value whose first characters are `$(` or a backtick is skipped with a lint
# diagnostic; that check is a lint convenience, not a security boundary (a
# value such as `true; touch x` is a normal command and is not inspected).
#
# Zero-config defaults are stack-generic. A Go repo's top-level test/ directory
# is an ordinary package unless the conf declares `go_harness=<path>` (for
# example `go_harness=test/e2e-parallel.sh`): the engine then keeps the
# harness's directory out of the Go package graph and runs the harness for the
# tests whose source references a changed path; the Go analyzer never reads
# carries: headers. The npm, python and rust analyzers select e2e suites by
# their carries: declarations (the carries layer, described below). The npm
# fast gates come from the scripts package.json actually declares (lint, test,
# and a TypeScript typecheck only when TypeScript is configured); the full tier
# reports every declared script that runs an e2e/*.mjs suite and every
# remaining suite. The python analyzer reports `python -m compileall -q`, the
# unit tests that import a changed module, and `pytest` in full; the rust
# analyzer reports `cargo build --all-targets`, the unit tests of the modules
# that contain or use a changed module, and `cargo test` in full. Either falls
# back to full when a changed module's tests cannot be resolved.
# Repository-specific commands belong in the conf.
#
# This is a verification reporter, not a release or deploy entry point.

set -u
export LC_ALL=C

usage() {
	cat >&2 <<'EOF'
usage: tools/verify-scope [--base <rev>] [--full] [--micro] [--json] [--run]
  --base <rev>   diff base (default: merge-base HEAD origin/<default>)
  --full         force the full tier whatever the diff
  --micro        micro-lane evidence: the base conf, fast phase + micro_check
  --json         print the report as one JSON object (needs python3)
  --run          print the report, then run the reported commands in order
EOF
}

base_arg=""
run=0
json=0
force_full=0
micro=0
while [ $# -gt 0 ]; do
	case "$1" in
	--base)
		[ $# -ge 2 ] || {
			echo "verify-scope: --base needs a revision" >&2
			usage
			exit 2
		}
		base_arg="$2"
		shift 2
		;;
	--base=*)
		base_arg="${1#--base=}"
		[ -n "$base_arg" ] || {
			echo "verify-scope: --base needs a revision" >&2
			usage
			exit 2
		}
		shift
		;;
	--run)
		run=1
		shift
		;;
	--json)
		json=1
		shift
		;;
	--full)
		force_full=1
		shift
		;;
	--micro)
		micro=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "verify-scope: unknown argument '$1'" >&2
		usage
		exit 2
		;;
	esac
done

if [ "$json" -eq 1 ] && ! command -v python3 >/dev/null 2>&1; then
	echo "verify-scope: --json needs python3 (a documented pf doctor prerequisite)" >&2
	exit 1
fi

root="$(pwd)"
tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM
: >"$tmp/diag"

# us is the ASCII unit separator: the field separator of the engine's own
# record files (a conf value is one line, so it never carries one in practice).
us="$(printf '\037')"

# ---------------------------------------------------------------------------
# Helpers.
# ---------------------------------------------------------------------------

# path_dir answers the repo-relative directory of a repo-relative path.
path_dir() {
	d="${1%/*}"
	[ "$d" = "$1" ] && d="."
	printf '%s' "$d"
}

# rel_dir maps an absolute package directory back to the repo root.
rel_dir() {
	case "$1" in
	"$root"/*) printf '%s' "${1#"$root"/}" ;;
	"$root") printf '.' ;;
	*) printf '%s' "$1" ;;
	esac
}

# join_pipe prints the lines it reads joined by `|` (input pre-sorted).
join_pipe() {
	awk 'NR > 1 { printf "|" } { printf "%s", $0 }'
}

# diag writes one diagnostic line to stderr and keeps it for the JSON report.
diag() {
	printf 'verify-scope: %s\n' "$1" >&2
	printf 'verify-scope: %s\n' "$1" >>"$tmp/diag"
}

# add_cmd appends one analyzer-default command of a phase (fast|full|scoped)
# to the report; its name (<phase>-<i>) is assigned once the list is complete.
add_cmd() { printf '%s%s%s%s%s%s%s\n' "" "$us" "$1" "$us" "default" "$us" "$2" >>"$tmp/commands"; }

# add_conf_cmds appends a phase's conf-declared commands (name<US>command
# records, file order) to the report.
add_conf_cmds() {
	while IFS="$us" read -r cn cc; do
		printf '%s%s%s%s%s%s%s\n' "$cn" "$us" "$1" "$us" "conf" "$us" "$cc" >>"$tmp/commands"
	done <"$2"
}

# ---------------------------------------------------------------------------
# Declarative conf. Every key is read without shell evaluation; a rejected
# line is diagnosed on stderr and contributes nothing.
# ---------------------------------------------------------------------------
conf_fast="$tmp/conf_fast"
conf_full="$tmp/conf_full"
conf_forced="$tmp/conf_forced"
conf_roots="$tmp/conf_roots"
conf_excl="$tmp/conf_excl"
conf_stack="$tmp/conf_stack"
conf_harness="$tmp/conf_harness"
conf_names="$tmp/conf_names"
conf_req_env="$tmp/conf_req_env"
conf_req_cmd="$tmp/conf_req_cmd"
conf_timeout="$tmp/conf_timeout"
conf_globs="$tmp/conf_globs"
conf_base_setup="$tmp/conf_base_setup"
conf_ci="$tmp/conf_ci"
conf_suite_glob="$tmp/conf_suite_glob"
conf_e2e_map="$tmp/conf_e2e_map"
conf_smoke="$tmp/conf_smoke"
conf_micro_path="$tmp/conf_micro_path"
conf_micro="$tmp/conf_micro"
: >"$conf_micro_path"
: >"$conf_micro"
: >"$conf_fast"
: >"$conf_full"
: >"$conf_forced"
: >"$conf_roots"
: >"$conf_excl"
: >"$conf_stack"
: >"$conf_harness"
: >"$conf_names"
: >"$conf_req_env"
: >"$conf_req_cmd"
: >"$conf_timeout"
: >"$conf_globs"
: >"$conf_base_setup"
: >"$conf_ci"
: >"$conf_suite_glob"
: >"$conf_e2e_map"
: >"$conf_smoke"
conf_runner=""
conf_e2e_runner=""
# conf_closed is set when a carries key (e2e_runner=, suite_glob=, e2e_map=)
# is empty or malformed: the report then falls back to the full tier, never
# to a narrower scope computed as if the key were absent.
conf_closed=0
# smoke_declared is set by any smoke_suite= line, valid or not: the repository
# opted into the full-tier e2e selection (a malformed line then selects the
# full e2e command instead of a selection computed without it).
smoke_declared=0
anon_fast=0
anon_full=0
anon_micro=0

# A positive Go duration (time.ParseDuration's grammar without a sign).
dur_re='^(([0-9]+(\.[0-9]*)?|\.[0-9]+)(ns|us|ms|s|m|h))+$'

# conf_cmd_ok answers 0 when a command value (key, value, line) is reportable;
# a rejected value is diagnosed and contributes nothing.
conf_cmd_ok() {
	case "$2" in
	'$('* | '`'*)
		diag "conf lint: $1 value begins with a command substitution (lint diagnostic only; command values run as reported command: lines): $3"
		return 1
		;;
	esac
	[ -n "$2" ] || {
		diag "conf ignores an empty $1"
		return 1
	}
	return 0
}

# conf_items splits a comma-separated list (class env: variable names; class
# cmd: executable names or paths) into $tmp/items, one per line, answering
# non-zero when the list is empty or any item is not of its class.
conf_items() {
	printf '%s\n' "$2" | tr ',' '\n' >"$tmp/items"
	while IFS= read -r it; do
		case "$1" in
		env)
			case "$it" in
			'' | [0-9]* | *[!A-Za-z0-9_]*) return 1 ;;
			esac
			;;
		cmd)
			case "$it" in
			'' | *[!A-Za-z0-9._+/-]*) return 1 ;;
			esac
			;;
		esac
	done <"$tmp/items"
	return 0
}

conf="$root/.polyforge/verify-scope.conf"
# --micro: the governing conf is the one at the diff base (the default base
# or --base), never the working tree's — a change cannot widen its own
# declaration. Absent or unreadable there = nothing declared.
if [ "$micro" -eq 1 ]; then
	conf="$tmp/base_conf"
	mbase="$base_arg"
	if [ -z "$mbase" ]; then
		mdefault="$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
		mdefault="${mdefault#origin/}"
		[ -n "$mdefault" ] || mdefault="main"
		mbase="$(git -C "$root" merge-base HEAD "origin/$mdefault" 2>/dev/null || true)"
	fi
	if [ -z "$mbase" ] || ! git -C "$root" show "$mbase:.polyforge/verify-scope.conf" >"$conf" 2>/dev/null; then
		rm -f "$conf"
		diag "--micro: no .polyforge/verify-scope.conf is readable at the diff base${mbase:+ $mbase}; the repository declares nothing"
	fi
fi
conf_state="absent"
if [ -f "$conf" ]; then
	conf_state="present"
	while IFS= read -r line || [ -n "$line" ]; do
		line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//')"
		case "$line" in
		'' | '#'*) continue ;;
		esac
		case "$line" in
		*=*) ;;
		*)
			diag "conf rejects a line without a key: $line"
			continue
			;;
		esac
		key="${line%%=*}"
		val="${line#*=}"
		case "$key" in
		stack)
			val="$(printf '%s' "$val" | sed 's/[[:space:]]*$//')"
			case "$val" in
			go | npm | python | rust | none) printf '%s\n' "$val" >>"$conf_stack" ;;
			*)
				diag "conf rejects stack '$val' (expected go, npm, python, rust or none)"
				;;
			esac
			;;
		fast_gate | full_command)
			conf_cmd_ok "$key" "$val" "$line" || continue
			if [ "$key" = "fast_gate" ]; then
				anon_fast=$((anon_fast + 1))
				printf '%s\n' "fast-$anon_fast" >>"$conf_names"
				printf '%s%s%s\n' "fast-$anon_fast" "$us" "$val" >>"$conf_fast"
			else
				anon_full=$((anon_full + 1))
				printf '%s\n' "full-$anon_full" >>"$conf_names"
				printf '%s%s%s\n' "full-$anon_full" "$us" "$val" >>"$conf_full"
			fi
			;;
		check)
			case "$val" in
			*'|'*'|'*) ;;
			*)
				diag "conf rejects check without the <name>|<fast|full>|<command> shape: $line"
				continue
				;;
			esac
			cname="${val%%|*}"
			crest="${val#*|}"
			cphase="${crest%%|*}"
			ccmd="${crest#*|}"
			case "$cname" in
			'' | [!A-Za-z0-9]* | *[!A-Za-z0-9._-]*)
				diag "conf rejects check name '$cname' (letters, digits, '.', '_' and '-', starting with a letter or digit): $line"
				continue
				;;
			fast-[0-9]* | full-[0-9]* | scoped-[0-9]* | micro-[0-9]*)
				diag "conf rejects check name '$cname' (reserved for the anonymous and analyzer commands): $line"
				continue
				;;
			esac
			case "$cphase" in
			fast | full) ;;
			*)
				diag "conf rejects check phase '$cphase' (expected fast or full): $line"
				continue
				;;
			esac
			if grep -Fxq -- "$cname" "$conf_names"; then
				diag "conf rejects a second check named '$cname': $line"
				continue
			fi
			conf_cmd_ok check "$ccmd" "$line" || continue
			printf '%s\n' "$cname" >>"$conf_names"
			if [ "$cphase" = "fast" ]; then
				printf '%s%s%s\n' "$cname" "$us" "$ccmd" >>"$conf_fast"
			else
				printf '%s%s%s\n' "$cname" "$us" "$ccmd" >>"$conf_full"
			fi
			;;
		check_requires_env | check_requires_cmd)
			case "$val" in
			*'|'*) ;;
			*)
				diag "conf rejects $key without the <name>|item[,item] shape: $line"
				continue
				;;
			esac
			rname="${val%%|*}"
			if [ "$key" = "check_requires_env" ]; then
				class="env"
				dest="$conf_req_env"
			else
				class="cmd"
				dest="$conf_req_cmd"
			fi
			if [ -z "$rname" ] || ! conf_items "$class" "${val#*|}"; then
				diag "conf rejects $key value (expected <name>|item[,item] with valid $class items): $line"
				continue
			fi
			while IFS= read -r it; do
				printf '%s%s%s\n' "$rname" "$us" "$it" >>"$dest"
			done <"$tmp/items"
			;;
		check_timeout)
			case "$val" in
			*'|'*) ;;
			*)
				diag "conf rejects check_timeout without the <name>|<duration> shape: $line"
				continue
				;;
			esac
			rname="${val%%|*}"
			dur="${val#*|}"
			if [ -z "$rname" ] || ! printf '%s\n' "$dur" | grep -Eq "$dur_re" || ! printf '%s\n' "$dur" | grep -q '[1-9]'; then
				diag "conf rejects check_timeout value (expected <name>|<positive Go duration such as 20m or 1h30m>): $line"
				continue
			fi
			if cut -d "$us" -f1 "$conf_timeout" | grep -Fxq -- "$rname"; then
				diag "conf ignores a second check_timeout for '$rname': $line"
				continue
			fi
			printf '%s%s%s\n' "$rname" "$us" "$dur" >>"$conf_timeout"
			;;
		test_glob)
			[ -n "$val" ] || {
				diag "conf ignores an empty test_glob"
				continue
			}
			printf '%s\n' "$val" >>"$conf_globs"
			;;
		base_setup)
			conf_cmd_ok "$key" "$val" "$line" || continue
			printf '%s\n' "$val" >>"$conf_base_setup"
			;;
		runner)
			val="$(printf '%s' "$val" | sed 's/[[:space:]]*$//')"
			case "$val" in
			complete) conf_runner="complete" ;;
			*)
				diag "conf rejects runner '$val' (expected complete)"
				;;
			esac
			;;
		ci_evidence)
			case "$val" in
			'' | /* | */) ;;
			*/*)
				printf '%s\n' "$val" >>"$conf_ci"
				continue
				;;
			esac
			diag "conf rejects ci_evidence value (expected <workflow>/<job>): $line"
			;;
		forced_full)
			[ -n "$val" ] || continue
			printf '%s\n' "$val" >>"$conf_forced"
			;;
		module_root)
			[ -n "$val" ] || continue
			printf '%s\n' "$val" >>"$conf_roots"
			;;
		exclude)
			[ -n "$val" ] || continue
			printf '%s\n' "$val" >>"$conf_excl"
			;;
		e2e_runner)
			val="$(printf '%s' "$val" | sed 's/[[:space:]]*$//')"
			case "$val" in
			'')
				diag "conf rejects an empty e2e_runner; falling back to the full tier: $line"
				conf_closed=1
				;;
			'$('* | '`'*)
				diag "conf rejects an e2e_runner value that begins with a command substitution; falling back to the full tier: $line"
				conf_closed=1
				;;
			*)
				if [ -n "$conf_e2e_runner" ]; then
					diag "conf rejects a second e2e_runner; falling back to the full tier: $line"
					conf_closed=1
				else
					conf_e2e_runner="$val"
				fi
				;;
			esac
			;;
		suite_glob)
			val="$(printf '%s' "$val" | sed 's/[[:space:]]*$//')"
			if [ -z "$val" ]; then
				diag "conf rejects an empty suite_glob; falling back to the full tier: $line"
				conf_closed=1
				continue
			fi
			printf '%s\n' "$val" >>"$conf_suite_glob"
			;;
		e2e_map)
			val="$(printf '%s' "$val" | sed 's/[[:space:]]*$//')"
			mglob="${val%%=*}"
			msuite="${val#*=}"
			case "$val" in
			*=*=* | =* | *=) mglob="" ;;
			*=*) ;;
			*) mglob="" ;;
			esac
			if [ -z "$mglob" ] || [ -z "$msuite" ]; then
				diag "conf rejects e2e_map value (expected <glob>=<suite>, split by exactly one '='); falling back to the full tier: $line"
				conf_closed=1
				continue
			fi
			printf '%s\n' "$val" >>"$conf_e2e_map"
			;;
		smoke_suite)
			smoke_declared=1
			val="$(printf '%s' "$val" | sed 's/[[:space:]]*$//')"
			case "$val" in
			'' | *[[:space:]]* | /* | ./* | ../* | */../*)
				diag "conf rejects smoke_suite value (expected one repository-relative suite path); falling back to the full tier: $line"
				conf_closed=1
				continue
				;;
			esac
			grep -Fxq -- "$val" "$conf_smoke" || printf '%s\n' "$val" >>"$conf_smoke"
			;;
		micro_path)
			val="$(printf '%s' "$val" | sed 's/[[:space:]]*$//')"
			case "$val" in
			'' | /* | ./* | ../* | */../* | .. | */..)
				diag "conf rejects micro_path value (expected one repository-relative path pattern, not absolute, ./-prefixed, blank or ..-escaping): $line"
				continue
				;;
			esac
			grep -Fxq -- "$val" "$conf_micro_path" || printf '%s\n' "$val" >>"$conf_micro_path"
			;;
		micro_check)
			conf_cmd_ok "$key" "$val" "$line" || continue
			anon_micro=$((anon_micro + 1))
			printf '%s\n' "micro-$anon_micro" >>"$conf_names"
			printf '%s%s%s\n' "micro-$anon_micro" "$us" "$val" >>"$conf_micro"
			;;
		go_harness)
			[ -n "$val" ] || {
				diag "conf ignores an empty go_harness"
				continue
			}
			printf '%s\n' "$val" >>"$conf_harness"
			;;
		*)
			diag "conf rejects unknown key '$key'"
			;;
		esac
	done <"$conf"
fi

# conf_bind keeps a check_* key's declarations whose name is a declared conf
# command and diagnoses (and drops) the rest; the check= line may follow the
# check_* line in the file.
conf_bind() {
	: >"$2.kept"
	while IFS="$us" read -r bn bv; do
		if grep -Fxq -- "$bn" "$conf_names"; then
			printf '%s%s%s\n' "$bn" "$us" "$bv" >>"$2.kept"
		else
			diag "conf ignores $1 for '$bn', which names no declared command (a check= name or fast-<i>/full-<i>/micro-<i>)"
		fi
	done <"$2"
	mv "$2.kept" "$2"
}
conf_bind check_requires_env "$conf_req_env"
conf_bind check_requires_cmd "$conf_req_cmd"
conf_bind check_timeout "$conf_timeout"

# go_harness is the repo's declared out-of-process acceptance harness value
# (reported as `sh <value>`); go_harness_dir is the directory whose Go packages
# it owns, kept out of the package graph and skipped by the `-run` selection.
# Without the key no directory is special-cased.
go_harness=""
go_harness_dir=""
if [ -s "$conf_harness" ]; then
	go_harness="$(head -n 1 "$conf_harness")"
	go_harness_dir="$(path_dir "$go_harness")"
fi

# path_excluded answers 0 when the path matches an exclude= glob (by path or
# by basename).
path_excluded() {
	p="$1"
	base="${p##*/}"
	while IFS= read -r g; do
		[ -n "$g" ] || continue
		case "$p" in $g) return 0 ;; esac
		case "$base" in $g) return 0 ;; esac
	done <"$conf_excl"
	return 1
}

# is_doc_path answers 0 for prose/documentation paths, which never count
# toward zero-config spanning.
is_doc_path() {
	case "$1" in
	*.md | *.markdown | *.rst | *.txt | docs/* | doc/*) return 0 ;;
	esac
	return 1
}

# ---------------------------------------------------------------------------
# Affected paths of base..HEAD (sorted, unique). Deleted files keep their
# pre-image path; a rename contributes both the old and the new path.
# ---------------------------------------------------------------------------
changed="$tmp/changed"
: >"$changed"
full=0
default="main"
base=""
base_sha=""
head_sha=""
if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	diag "not a git work tree; falling back to the full tier"
	full=1
else
	default="$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
	default="${default#origin/}"
	[ -n "$default" ] || default="main"
	head_sha="$(git -C "$root" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null || true)"
	if [ -n "$base_arg" ]; then
		base="$base_arg"
	else
		base="$(git -C "$root" merge-base HEAD "origin/$default" 2>/dev/null || true)"
		if [ -z "$base" ]; then
			diag "cannot resolve the base (merge-base HEAD origin/$default); falling back to the full tier"
		fi
	fi
	if [ -n "$base" ]; then
		base_sha="$(git -C "$root" rev-parse -q --verify "$base^{commit}" 2>/dev/null || true)"
	fi
	if [ -z "$base" ]; then
		full=1
	elif git -C "$root" diff --name-status -M "$base"..HEAD >"$tmp/diff" 2>>"$tmp/stderr"; then
		: >"$tmp/changed_raw"
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			status="${line%%	*}"
			rest="${line#*	}"
			case "$status" in
			R* | C*)
				printf '%s\n' "${rest%%	*}" >>"$tmp/changed_raw"
				printf '%s\n' "${rest#*	}" >>"$tmp/changed_raw"
				;;
			*)
				printf '%s\n' "$rest" >>"$tmp/changed_raw"
				;;
			esac
		done <"$tmp/diff"
		if [ -s "$tmp/changed_raw" ]; then
			sort -u "$tmp/changed_raw" >"$changed"
		fi
	else
		diag "cannot diff $base..HEAD; falling back to the full tier"
		full=1
	fi
fi

# conf_changed answers whether the diff changed the conf: the conf is among
# the affected paths, or it differs between the base and HEAD.
conf_changed="false"
if grep -Fxq ".polyforge/verify-scope.conf" "$changed"; then
	conf_changed="true"
elif [ -n "$base_sha" ] && [ -n "$head_sha" ] &&
	! git -C "$root" diff --quiet "$base_sha" "$head_sha" -- .polyforge/verify-scope.conf 2>/dev/null; then
	conf_changed="true"
fi

# --full forces the full tier; it never narrows anything.
[ "$force_full" -eq 1 ] && full=1
# --micro computes no tier (its commands are the fast phase plus the
# micro checks), so the scoped analysis is skipped.
[ "$micro" -eq 1 ] && full=1
# An empty or malformed carries key fails closed whatever the diff.
[ "$conf_closed" -eq 1 ] && full=1

# ---------------------------------------------------------------------------
# Stack detection.
# ---------------------------------------------------------------------------
# Conf first: with no analyzer the report is the full tier with the conf's
# commands only, so the no-analyzer diagnostics name what the report carries.
if [ -s "$conf_fast" ] || [ -s "$conf_full" ]; then
	conf_only="the full tier with the conf's commands only"
else
	conf_only="the full tier with no commands (the conf declares none)"
fi
analyzer=""
stack=""
if [ -s "$conf_stack" ]; then
	stack="$(head -n 1 "$conf_stack")"
	if [ "$stack" = "none" ]; then
		diag "stack=none pins no analyzer; $conf_only"
	else
		analyzer="$stack"
	fi
else
	# One supported manifest selects its analyzer; two or more without a
	# stack= pin are ambiguous.
	found=""
	found_names=""
	[ -f "$root/go.mod" ] && found="$found go" && found_names="$found_names, go.mod"
	[ -f "$root/package.json" ] && found="$found npm" && found_names="$found_names, package.json"
	if [ -f "$root/pyproject.toml" ] || [ -f "$root/requirements.txt" ]; then
		found="$found python"
		found_names="$found_names, pyproject.toml/requirements.txt"
	fi
	[ -f "$root/Cargo.toml" ] && found="$found rust" && found_names="$found_names, Cargo.toml"
	found="${found# }"
	found_names="${found_names#, }"
	case "$found" in
	'')
		stack="unsupported"
		diag "no supported stack manifest (go.mod, package.json, pyproject.toml, requirements.txt or Cargo.toml); falling back to $conf_only"
		;;
	*' '*)
		stack="ambiguous"
		diag "several stack manifests ($found_names) are present without a stack= pin; falling back to $conf_only"
		;;
	*)
		stack="$found"
		analyzer="$found"
		;;
	esac
fi

# The npm analyzer reads the scripts package.json actually declares. Node is
# present wherever npm is; if it cannot read the manifest, the scope cannot be
# computed and the report fails closed with no commands.
npm_scripts="$tmp/npm_scripts"
: >"$npm_scripts"
if [ "$analyzer" = "npm" ]; then
	if command -v node >/dev/null 2>&1 && node -e '
		const fs = require("fs");
		const p = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
		const s = p && p.scripts && typeof p.scripts === "object" ? p.scripts : {};
		for (const k of Object.keys(s)) {
			if (typeof s[k] === "string") console.log(k + "\t" + s[k]);
		}
	' "$root/package.json" >"$npm_scripts" 2>>"$tmp/stderr"; then
		:
	else
		diag "cannot read package.json scripts; falling back to $conf_only"
		analyzer=""
	fi
fi

# npm_has_script answers 0 when package.json declares the named script.
npm_has_script() {
	awk -F'\t' -v n="$1" '$1 == n { found = 1 } END { exit found ? 0 : 1 }' "$npm_scripts"
}

# npm_has_typescript answers 0 when the package configures TypeScript.
npm_has_typescript() {
	[ -f "$root/tsconfig.json" ] && return 0
	grep -q '"typescript"[[:space:]]*:' "$root/package.json" 2>/dev/null
}

# npm_script_suites lists name<TAB>e2e/file pairs for every declared script
# whose command runs an e2e/*.mjs suite, so the suite is reported through its
# script and not repeated standalone.
npm_script_suites() {
	while IFS='	' read -r name cmd; do
		[ -n "$name" ] || continue
		printf '%s\n' "$cmd" |
			tr -c 'A-Za-z0-9._/-' '\n' |
			grep -E '^e2e/[A-Za-z0-9._-]+\.mjs$' 2>/dev/null |
			sort -u |
			while IFS= read -r ref; do
				printf '%s\t%s\n' "$name" "$ref"
			done
	done <"$npm_scripts"
}

# No analyzer: always the full tier, with the conf's commands only (the
# forced-full triggers and the scoped selection need an analyzer).
[ -n "$analyzer" ] || full=1

# ---------------------------------------------------------------------------
# Forced-full triggers: stack-generic config files plus the repo's globs.
# ---------------------------------------------------------------------------
path_forced() {
	p="$1"
	base="${p##*/}"
	case "$analyzer" in
	go)
		case "$p" in go.mod | go.sum) return 0 ;; esac
		;;
	npm)
		case "$p" in package.json | package-lock.json | npm-shrinkwrap.json | tsconfig.json) return 0 ;; esac
		case "$base" in tsconfig.* | eslint.config.* | .eslintrc | .eslintrc.*) return 0 ;; esac
		;;
	python)
		case "$p" in pyproject.toml | requirements*.txt | setup.py | setup.cfg | pytest.ini | tox.ini) return 0 ;; esac
		case "$base" in conftest.py) return 0 ;; esac
		;;
	rust)
		case "$p" in Cargo.toml | Cargo.lock | build.rs | rust-toolchain | rust-toolchain.toml | .cargo/*) return 0 ;; esac
		;;
	esac
	while IFS= read -r g; do
		[ -n "$g" ] || continue
		case "$p" in $g) return 0 ;; esac
		case "$base" in $g) return 0 ;; esac
	done <"$conf_forced"
	return 1
}

# spans_multiple_roots answers 0 when the changed paths touch two or more
# module roots. With a conf the roots are its module_root= list; otherwise
# each path's first-level directory is its root, and prose/doc paths never
# count.
spans_multiple_roots() {
	roots="$tmp/span_roots"
	: >"$roots"
	if [ -s "$conf_roots" ]; then
		while IFS= read -r p; do
			[ -n "$p" ] || continue
			path_excluded "$p" && continue
			while IFS= read -r r; do
				[ -n "$r" ] || continue
				case "$p" in
				"$r" | "$r"/*)
					printf '%s\n' "$r" >>"$roots"
					;;
				esac
			done <"$conf_roots"
		done <"$changed"
	else
		while IFS= read -r p; do
			[ -n "$p" ] || continue
			path_excluded "$p" && continue
			is_doc_path "$p" && continue
			case "$p" in
			*/*) printf '%s\n' "${p%%/*}" >>"$roots" ;;
			*) printf '%s\n' "." >>"$roots" ;;
			esac
		done <"$changed"
	fi
	[ "$(sort -u "$roots" | wc -l | tr -d ' ')" -ge 2 ]
}

if [ "$full" -eq 0 ]; then
	while IFS= read -r p; do
		if path_forced "$p"; then
			full=1
			break
		fi
	done <"$changed"
fi
if [ "$full" -eq 0 ] && [ "$analyzer" = "go" ] && spans_multiple_roots; then
	full=1
fi

# ---------------------------------------------------------------------------
# Scoped selection. Answers non-zero when the package graph cannot be
# computed, which turns the scope into the full tier instead of a wrong
# scoped one.
# ---------------------------------------------------------------------------
: >"$tmp/scoped_cmds"
add_scoped() { printf '%s\n' "$1" >>"$tmp/scoped_cmds"; }

compute_scoped_go() {
	golist="$tmp/golist"
	if ! (cd "$root" && GOWORK=off go list -test -f '{{.ImportPath}}|{{.Dir}}|{{join .Deps " "}}|{{len .TestGoFiles}}|{{len .XTestGoFiles}}' ./...) >"$golist" 2>>"$tmp/stderr"; then
		diag "go list failed; falling back to the full tier"
		return 1
	fi
	# Fail closed on an unexpected go list -test shape. Every record must carry
	# the import path, the package directory, the dependency closure and the two
	# test-file counts; every package that has test files must also have its
	# `P.test` record, whose closure the fold below needs. A toolchain that stops
	# emitting either fails the graph computation instead of silently degrading
	# to plain Deps.
	if ! awk -F'|' '
		NF < 5 { bad = 1 }
		$1 ~ /\.test$/ { testrec[$2] = 1; next }
		$1 ~ / \[/ { next }
		{ if (($4 + 0) > 0 || ($5 + 0) > 0) hastests[$2] = 1 }
		END {
			for (d in hastests) if (!(d in testrec)) bad = 1
			exit bad ? 1 : 0
		}
	' "$golist"; then
		diag "unexpected go list -test output shape; falling back to the full tier"
		return 1
	fi
	# go list -test also emits each package's test binary (`P.test`), whose
	# Deps is the closure of everything `go test` compiles for P — test imports
	# included. Fold that closure into P's plain entry, so the reverse-dependency
	# scan below selects a package reached only through a `_test.go` import. The
	# test-variant entries (`P [P.test]`, `P_test [P.test]`) are dropped: `go test
	# ./P` already runs them with P.
	packages="$tmp/packages"
	awk -F'|' '
		FNR == NR { if ($1 ~ /\.test$/) tdeps[$2] = $3; next }
		$1 ~ / \[/ { next }
		$1 ~ /\.test$/ { next }
		$2 in tdeps { print $1 "|" $2 "|" tdeps[$2]; next }
		{ print $1 "|" $2 "|" $3 }
	' "$golist" "$golist" >"$packages"
	# Map each changed path to its nearest ancestor `go list` package
	# directory: a file in `<pkg>/testdata/` or another package subdirectory
	# belongs to its owning package. A path with no ancestor package selects
	# no package (and no test).
	pkg_dirs="$tmp/pkg_dirs"
	: >"$pkg_dirs"
	while IFS='|' read -r imp dir deps; do
		[ -n "$imp" ] || continue
		printf '%s\n' "$(rel_dir "$dir")" >>"$pkg_dirs"
	done <"$packages"
	sort -u "$pkg_dirs" -o "$pkg_dirs"
	mapped_dirs="$tmp/mapped_dirs"
	: >"$mapped_dirs"
	while IFS= read -r p; do
		d="$(path_dir "$p")"
		while :; do
			if grep -Fxq -- "$d" "$pkg_dirs"; then
				printf '%s\n' "$d" >>"$mapped_dirs"
				break
			fi
			[ "$d" = "." ] && break
			case "$d" in
			*/*) d="${d%/*}" ;;
			*) d="." ;;
			esac
		done
	done <"$changed"
	sort -u "$mapped_dirs" -o "$mapped_dirs"
	changed_imports="$tmp/changed_imports"
	: >"$changed_imports"
	while IFS='|' read -r imp dir deps; do
		[ -n "$imp" ] || continue
		rel="$(rel_dir "$dir")"
		if grep -Fxq -- "$rel" "$mapped_dirs"; then
			printf '%s\n' "$imp" >>"$changed_imports"
		fi
	done <"$packages"
	# Changed packages plus every package that (transitively) depends on one.
	selected="$tmp/selected"
	: >"$selected"
	if [ -s "$changed_imports" ]; then
		while IFS='|' read -r imp dir deps; do
			[ -n "$imp" ] || continue
			rel="$(rel_dir "$dir")"
			# A declared harness owns its directory; otherwise it is an
			# ordinary package and participates in the graph.
			if [ -n "$go_harness" ] && [ "$rel" = "$go_harness_dir" ]; then
				continue
			fi
			sel=0
			if grep -Fxq -- "$rel" "$mapped_dirs"; then
				sel=1
			else
				while IFS= read -r cp; do
					case " $deps " in
					*" $cp "*)
						sel=1
						break
						;;
					esac
				done <"$changed_imports"
			fi
			[ "$sel" -eq 1 ] && printf '%s\n' "$rel" >>"$selected"
		done <"$packages"
	fi
	if [ -s "$selected" ]; then
		sort -u "$selected" -o "$selected"
		pkgargs=""
		while IFS= read -r rel; do
			if [ "$rel" = "." ]; then
				pkgargs="$pkgargs ."
			else
				pkgargs="$pkgargs ./$rel"
			fi
		done <"$selected"
		add_scoped "GOWORK=off go test -count=1$pkgargs"
	fi
	# Tests that textually name a changed path, per package not already in
	# the package command. A declared harness is handled below instead.
	tr_pairs="$tmp/tr_pairs"
	: >"$tr_pairs"
	while IFS= read -r p; do
		while IFS= read -r f; do
			[ -n "$f" ] || continue
			if [ -n "$go_harness" ]; then
				case "$f" in
				"$go_harness_dir"/*) continue ;;
				esac
			fi
			case "$f" in
			*_test.go) ;;
			*) continue ;;
			esac
			names="$(sed -n 's/^func \(Test[^ (]*\).*/\1/p' "$root/$f" | sort -u)"
			[ -n "$names" ] || continue
			d="$(path_dir "$f")"
			while IFS= read -r name; do
				[ -n "$name" ] && printf '%s|%s\n' "$d" "$name" >>"$tr_pairs"
			done <<EOF
$names
EOF
		done <<EOF
$(git -C "$root" grep -F -l -e "$p" 2>/dev/null || true)
EOF
	done <"$changed"
	if [ -s "$tr_pairs" ]; then
		cut -d'|' -f1 "$tr_pairs" | sort -u >"$tmp/tr_dirs"
		while IFS= read -r d; do
			grep -Fxq -- "$d" "$selected" && continue
			names="$(awk -F'|' -v d="$d" '$1 == d { print $2 }' "$tr_pairs" | sort -u | join_pipe)"
			if [ "$d" = "." ]; then
				pkg="."
			else
				pkg="./$d"
			fi
			add_scoped "GOWORK=off go test -count=1 -run '^($names)\$' $pkg"
		done <"$tmp/tr_dirs"
	fi
	# The repo's declared harness runs the acceptance tests whose source
	# names a changed path, by test name.
	if [ -n "$go_harness" ]; then
		: >"$tmp/e2e_names"
		while IFS= read -r p; do
			while IFS= read -r f; do
				[ -n "$f" ] || continue
				case "$f" in
				"$go_harness_dir"/*.go) ;;
				*) continue ;;
				esac
				sed -n 's/^func \(Test[^ (]*\).*/\1/p' "$root/$f" >>"$tmp/e2e_names"
			done <<EOF
$(git -C "$root" grep -F -l -e "$p" 2>/dev/null || true)
EOF
		done <"$changed"
		if [ -s "$tmp/e2e_names" ]; then
			names="$(sort -u "$tmp/e2e_names" | join_pipe)"
			add_scoped "E2E_RUN='^($names)\$' sh $go_harness"
		fi
	fi
	return 0
}

# ---------------------------------------------------------------------------
# Carries layer (stack-neutral). A suite declares the repository paths it
# covers in its opening comment block — the leading blank and comment lines
# (`//` or `#`) before the first line of code:
#
#   // carries: components/Panel*, lib/panel*
#
# Several carries: lines union; globs are separated by commas or blanks and
# use the shell-case syntax forced_full= and exclude= use (`*` crosses `/`).
# A carries: line after the first code line is not a declaration. Suites are
# the analyzer's default discovery — npm e2e/*.mjs, python test_*.py and
# *_test.py under e2e/ or tests/e2e/, rust top-level tests/*.rs — or the conf's
# suite_glob= globs, minus exclude= matches and the e2e_runner= target; a
# discovered file that another module imports and that declares nothing is a
# helper, not a suite. Selected suites run as one e2e_runner= command, else
# one `node <suite>`, `pytest <suite>` or `cargo test --test <name>` each.
# e2e_map=<glob>=<suite> replaces that suite's declaration outright. The layer
# is on only when at least one suite exists. Selection: every suite whose
# globs match a changed path, a changed suite itself, and every suite that
# (transitively) imports a changed helper. Any undeclared or malformed suite,
# an unresolvable import, an e2e_map= naming no suite, or a changed path that
# is neither documentation, an exclude= match, a suite, a helper nor covered
# by a declaration falls back to the full tier (the full-tier e2e selection
# lists such a path instead; see the opening contract).
# ---------------------------------------------------------------------------
cr_files="$tmp/cr_files"
cr_cand="$tmp/cr_cand"
cr_runner="$tmp/cr_runner"
cr_status="$tmp/cr_status"
cr_decl="$tmp/cr_decl"
cr_nodes="$tmp/cr_nodes"
cr_edges="$tmp/cr_edges"
cr_unres="$tmp/cr_unres"
cr_suites="$tmp/cr_suites"
cr_maperr="$tmp/cr_maperr"
for f in "$cr_files" "$cr_cand" "$cr_runner" "$cr_status" "$cr_decl" "$cr_nodes" \
	"$cr_edges" "$cr_unres" "$cr_suites" "$cr_maperr"; do
	: >"$f"
done

# cr_list_files lists the repository's files (tracked and untracked, ignored
# files left out), repo-relative and sorted.
cr_list_files() {
	if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		git -C "$root" -c core.quotePath=off ls-files -co --exclude-standard 2>/dev/null
	else
		(cd "$root" && find . -type f ! -path './.git/*' | sed 's#^\./##')
	fi | sort -u >"$tmp/cr_listed"
	: >"$cr_files"
	while IFS= read -r f; do
		[ -f "$root/$f" ] && printf '%s\n' "$f" >>"$cr_files"
	done <"$tmp/cr_listed"
}

# cr_default_discover prints the analyzer's default suite candidates.
cr_default_discover() {
	case "$analyzer" in
	npm) awk '/^e2e\/[^\/]*\.mjs$/' "$cr_files" ;;
	python)
		# pytest collection: test_*.py / *_test.py under e2e/ or tests/e2e/;
		# conftest.py, __init__.py and other modules there are not suites.
		awk '/^(tests\/)?e2e\// && /(^|\/)(test_[^\/]*|[^\/]*_test)\.py$/' "$cr_files"
		;;
	rust)
		# Integration-test crates: top-level tests/*.rs only (tests/common/
		# and other subdirectories hold helper modules).
		awk '/^tests\/[^\/]*\.rs$/' "$cr_files"
		;;
	esac
}

# cr_is_module answers 0 for a file whose imports the analyzer follows.
cr_is_module() {
	case "$analyzer" in
	npm)
		case "$1" in
		*.mjs | *.js | *.cjs | *.ts | *.tsx | *.mts | *.cts | *.jsx) return 0 ;;
		esac
		;;
	python)
		case "$1" in *.py) return 0 ;; esac
		;;
	rust)
		case "$1" in *.rs) return 0 ;; esac
		;;
	esac
	return 1
}

# cr_norm joins a repo-relative directory and a relative specifier, folding
# `.` and `..`; it prints nothing when the result leaves the repository.
cr_norm() {
	printf '%s/%s\n' "$1" "$2" | awk -F/ '{
		n = 0
		for (i = 1; i <= NF; i++) {
			if ($i == "" || $i == ".") continue
			if ($i == "..") { if (n == 0) exit; n--; continue }
			s[++n] = $i
		}
		if (n == 0) exit
		out = s[1]
		for (i = 2; i <= n; i++) out = out "/" s[i]
		print out
	}'
}

# cr_imports prints "<importer><US><target>" for every relative import of a
# module, or "<importer><US>?<specifier>" for one that does not resolve.
cr_imports() {
	f="$1"
	d="$(path_dir "$f")"
	case "$analyzer" in
	npm)
		grep -oE "(from|import|require)[[:space:]]*\(?[[:space:]]*['\"]\.\.?/[^'\"]+['\"]" "$root/$f" 2>/dev/null |
			sed -E "s/^.*['\"](\.\.?\/[^'\"]+)['\"]$/\1/" | sort -u |
			while IFS= read -r spec; do
				[ -n "$spec" ] || continue
				t="$(cr_norm "$d" "$spec")"
				hit=""
				if [ -n "$t" ]; then
					for c in "$t" "$t.mjs" "$t.js" "$t.cjs" "$t.ts" "$t.tsx" "$t.mts" "$t.jsx" \
						"$t/index.mjs" "$t/index.js" "$t/index.ts" "$t/index.tsx"; do
						if [ -f "$root/$c" ]; then
							hit="$c"
							break
						fi
					done
				fi
				if [ -n "$hit" ]; then
					printf '%s%s%s\n' "$f" "$us" "$hit"
				else
					printf '%s%s?%s\n' "$f" "$us" "$spec"
				fi
			done
		;;
	python)
		awk -F "$us" -v f="$f" '$1 == f' "$py_edges"
		;;
	rust)
		awk -F "$us" -v f="$f" '$1 == f' "$rs_edges"
		;;
	esac
}

# cr_header parses a suite's opening comment block: "declared" then one glob
# per line, "undeclared", or "malformed" (an empty carries: value, or a
# carries line without its colon).
cr_header() {
	awk '
		function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
		{
			t = trim($0)
			if (t == "") next
			if (t !~ /^(\/\/|#)/) exit
			c = t
			sub(/^(\/\/+|#+)!?[ \t]*/, "", c)
			if (c ~ /^carries[ \t]*:/) {
				v = c
				sub(/^carries[ \t]*:/, "", v)
				v = trim(v)
				if (v == "") { bad = 1; next }
				n = split(v, a, /[ \t,]+/)
				for (i = 1; i <= n; i++) if (a[i] != "") g[++ng] = a[i]
				next
			}
			if (c ~ /^carries([^A-Za-z0-9_-]|$)/) bad = 1
		}
		END {
			if (bad) { print "malformed"; exit }
			if (ng == 0) { print "undeclared"; exit }
			print "declared"
			for (i = 1; i <= ng; i++) print g[i]
		}
	' "$root/$1"
}

# cr_runner_targets lists the files the declared e2e_runner= runs (through the
# npm script when the value is `npm run <script> ...`): runners, not suites.
cr_runner_targets() {
	: >"$cr_runner"
	[ -n "$conf_e2e_runner" ] || return 0
	set -f
	# shellcheck disable=SC2086
	set -- $conf_e2e_runner
	words="$*"
	if [ "${1:-}" = "npm" ] && [ "${2:-}" = "run" ] && [ -n "${3:-}" ]; then
		words="$words $(awk -F'\t' -v n="$3" '$1 == n { print $2; exit }' "$npm_scripts")"
	fi
	# shellcheck disable=SC2086
	for w in $words; do
		w="${w#./}"
		[ -n "$w" ] && [ -f "$root/$w" ] && printf '%s\n' "$w" >>"$cr_runner"
	done
	set +f
	sort -u "$cr_runner" -o "$cr_runner"
}

# carries_discover enumerates the candidates, follows their imports, parses
# every declaration and answers the suite set in $cr_suites. It writes no
# diagnostic: the scoped computation reports what it finds.
carries_discover() {
	cr_runner_targets
	if [ -s "$conf_suite_glob" ]; then
		while IFS= read -r f; do
			while IFS= read -r g; do
				case "$f" in
				$g)
					printf '%s\n' "$f"
					break
					;;
				esac
			done <"$conf_suite_glob"
		done <"$cr_files"
	else
		cr_default_discover
	fi | while IFS= read -r f; do
		path_excluded "$f" && continue
		grep -Fxq -- "$f" "$cr_runner" && continue
		printf '%s\n' "$f"
	done | sort -u >"$cr_cand"

	# The import graph: every module reachable from a candidate.
	cp "$cr_cand" "$cr_nodes"
	cp "$cr_cand" "$tmp/cr_frontier"
	while [ -s "$tmp/cr_frontier" ]; do
		: >"$tmp/cr_next"
		while IFS= read -r f; do
			cr_is_module "$f" || continue
			cr_imports "$f" >"$tmp/cr_imp"
			while IFS="$us" read -r imp tgt; do
				case "$tgt" in
				'?'*) printf '%s%s%s\n' "$imp" "$us" "${tgt#?}" >>"$cr_unres" ;;
				*)
					printf '%s%s%s\n' "$imp" "$us" "$tgt" >>"$cr_edges"
					printf '%s\n' "$tgt" >>"$tmp/cr_next"
					;;
				esac
			done <"$tmp/cr_imp"
		done <"$tmp/cr_frontier"
		sort -u "$tmp/cr_next" | comm -23 - "$cr_nodes" >"$tmp/cr_frontier"
		cat "$tmp/cr_frontier" >>"$cr_nodes"
		sort -u "$cr_nodes" -o "$cr_nodes"
	done
	cut -d "$us" -f2 "$cr_edges" | sort -u >"$tmp/cr_imported"

	# Declarations: the header, or the conf's e2e_map= lines, which replace it.
	while IFS= read -r f; do
		if cut -d= -f2- "$conf_e2e_map" | grep -Fxq -- "$f"; then
			printf '%s%s%s\n' "$f" "$us" "declared" >>"$cr_status"
			while IFS= read -r m; do
				[ "${m#*=}" = "$f" ] && printf '%s%s%s\n' "$f" "$us" "${m%%=*}" >>"$cr_decl"
			done <"$conf_e2e_map"
			continue
		fi
		cr_header "$f" >"$tmp/cr_hdr"
		st="$(head -n 1 "$tmp/cr_hdr")"
		printf '%s%s%s\n' "$f" "$us" "$st" >>"$cr_status"
		tail -n +2 "$tmp/cr_hdr" | while IFS= read -r g; do
			printf '%s%s%s\n' "$f" "$us" "$g"
		done >>"$cr_decl"
	done <"$cr_cand"
	while IFS= read -r m; do
		grep -Fxq -- "${m#*=}" "$cr_cand" || printf '%s\n' "${m#*=}" >>"$cr_maperr"
	done <"$conf_e2e_map"

	# Suites: every candidate except an undeclared one another module imports.
	while IFS="$us" read -r f st; do
		if [ "$st" = "undeclared" ] && grep -Fxq -- "$f" "$tmp/cr_imported"; then
			continue
		fi
		printf '%s\n' "$f"
	done <"$cr_status" | sort -u >"$cr_suites"
}

# cr_importer_suites prints every suite that (transitively) imports a module.
cr_importer_suites() {
	printf '%s\n' "$1" >"$tmp/cr_rfront"
	printf '%s\n' "$1" >"$tmp/cr_rseen"
	while [ -s "$tmp/cr_rfront" ]; do
		awk -F "$us" 'FNR == NR { want[$0] = 1; next } ($2 in want) { print $1 }' \
			"$tmp/cr_rfront" "$cr_edges" | sort -u | comm -23 - "$tmp/cr_rseen" >"$tmp/cr_rnext"
		cat "$tmp/cr_rnext" >>"$tmp/cr_rseen"
		sort -u "$tmp/cr_rseen" -o "$tmp/cr_rseen"
		mv "$tmp/cr_rnext" "$tmp/cr_rfront"
	done
	grep -Fxv -- "$1" "$tmp/cr_rseen" | grep -Fx -f "$cr_suites" 2>/dev/null || true
}

# cr_suite_cmd prints the analyzer's default command for one suite.
cr_suite_cmd() {
	case "$analyzer" in
	npm) printf 'node %s\n' "$1" ;;
	python) printf 'pytest %s\n' "$1" ;;
	rust)
		n="${1##*/}"
		printf 'cargo test --test %s\n' "${n%.rs}"
		;;
	esac
}

# cr_structure diagnoses every structural reason the declarations cannot be
# trusted — an undeclared or malformed suite, an unresolvable import — and
# answers non-zero when there is one (the e2e_map= check is the caller's, it
# holds even without a suite).
cr_structure() {
	cs_bad=0
	while IFS="$us" read -r f st; do
		grep -Fxq -- "$f" "$cr_suites" || continue
		case "$st" in
		undeclared)
			diag "carries: suite $f declares no carries: header in its opening comment block; falling back to the full tier"
			cs_bad=1
			;;
		malformed)
			diag "carries: suite $f has a malformed carries: declaration (an empty value or a carries line without its colon); falling back to the full tier"
			cs_bad=1
			;;
		esac
	done <"$cr_status"
	while IFS="$us" read -r imp spec; do
		diag "carries: $imp imports $spec, which does not resolve; the import graph is unresolvable, falling back to the full tier"
		cs_bad=1
	done <"$cr_unres"
	return "$cs_bad"
}

# cr_maperr_diag diagnoses every e2e_map= naming no discovered suite and
# answers non-zero when there is one.
cr_maperr_diag() {
	cm_bad=0
	while IFS= read -r s; do
		diag "carries: e2e_map names $s, which is not a discovered suite; falling back to the full tier"
		cm_bad=1
	done <"$cr_maperr"
	return "$cm_bad"
}

# cr_select writes the suites the changed paths select to $tmp/cr_sel (sorted,
# unique) and every changed path that is neither documentation, an exclude=
# match, a suite, a helper nor covered by a declaration to $tmp/cr_uncov.
cr_select() {
	: >"$tmp/cr_selected"
	: >"$tmp/cr_uncov"
	while IFS= read -r p; do
		[ -n "$p" ] || continue
		hit=0
		if grep -Fxq -- "$p" "$cr_suites"; then
			printf '%s\n' "$p" >>"$tmp/cr_selected"
			hit=1
		fi
		if grep -Fxq -- "$p" "$cr_nodes"; then
			cr_importer_suites "$p" >"$tmp/cr_imps"
			if [ -s "$tmp/cr_imps" ]; then
				cat "$tmp/cr_imps" >>"$tmp/cr_selected"
				hit=1
			fi
		fi
		while IFS="$us" read -r s g; do
			case "$p" in
			$g)
				printf '%s\n' "$s" >>"$tmp/cr_selected"
				hit=1
				;;
			esac
		done <"$cr_decl"
		[ "$hit" -eq 1 ] && continue
		is_doc_path "$p" && continue
		path_excluded "$p" && continue
		printf '%s\n' "$p" >>"$tmp/cr_uncov"
	done <"$changed"
	sort -u "$tmp/cr_selected" | grep -Fx -f "$cr_suites" >"$tmp/cr_sel" 2>/dev/null || true
}

# cr_suite_cmds prints the command(s) that run the suites listed in a file:
# one e2e_runner= command, else the analyzer's default command per suite.
cr_suite_cmds() {
	[ -s "$1" ] || return 0
	if [ -n "$conf_e2e_runner" ]; then
		printf '%s %s\n' "$conf_e2e_runner" "$(tr '\n' ' ' <"$1" | sed 's/ $//')"
	else
		while IFS= read -r s; do
			cr_suite_cmd "$s"
		done <"$1"
	fi
}

# carries_scoped adds the selected suites to the scoped commands; it answers
# non-zero (after diagnosing every reason) when the declarations cannot
# account for the diff. The scoped tier never adds the smoke suites and an
# uncovered path still falls back to the full tier.
carries_scoped() {
	bad=0
	cr_maperr_diag || bad=1
	[ -s "$cr_suites" ] || return "$bad"
	cr_structure || bad=1
	cr_select
	while IFS= read -r p; do
		diag "carries: changed path $p is covered by no carries: declaration; falling back to the full tier"
		bad=1
	done <"$tmp/cr_uncov"
	[ "$bad" -eq 0 ] || return 1
	cr_suite_cmds "$tmp/cr_sel" >"$tmp/cr_sel_cmds"
	while IFS= read -r c; do
		add_scoped "$c"
	done <"$tmp/cr_sel_cmds"
	return 0
}

compute_scoped_npm() {
	carries_scoped
}

# ---------------------------------------------------------------------------
# Python analyzer. Imports are scanned statically (`import a.b`, `from a
# import b`, relative `from .x import y`) and resolved to repository modules
# (from the root, from src/, or beside the importer, as pytest's rootdir
# insertion does); an absolute import that names no repository module is a
# third-party import, while a relative one that resolves nowhere is an
# unresolvable import.
# ---------------------------------------------------------------------------
py_edges="$tmp/py_edges"
: >"$py_edges"

# is_py_test answers 0 for a pytest-collected file name.
is_py_test() {
	case "${1##*/}" in
	test_*.py | *_test.py) return 0 ;;
	esac
	return 1
}

# py_scan writes "<importer><US><module file>" (or "<importer><US>?<spec>")
# for every .py file of the repository.
py_scan() {
	: >"$py_edges"
	grep '\.py$' "$cr_files" >"$tmp/py_files" || return 0
	(cd "$root" && tr '\n' '\0' <"$tmp/py_files" |
		xargs -0 awk -v US="$us" '
		function res(p) {
			if ((p ".py") in exists) return p ".py"
			if ((p "/__init__.py") in exists) return p "/__init__.py"
			return ""
		}
		function emit(r) { if (r != "" && r != f) print f US r }
		function absimp(m,   p, r) {
			p = m
			gsub(/\./, "/", p)
			r = res(p)
			if (r == "") r = res("src/" p)
			if (r == "" && dir != "") r = res(dir "/" p)
			emit(r)
		}
		FNR == NR { exists[$0] = 1; next }
		FNR == 1 {
			f = FILENAME
			dir = f
			if (sub(/\/[^\/]*$/, "", dir) == 0) dir = ""
		}
		{
			line = $0
			sub(/#.*/, "", line)
			if (match(line, /^[ \t]*import[ \t]+/)) {
				n = split(substr(line, RLENGTH + 1), parts, ",")
				for (i = 1; i <= n; i++) {
					m = parts[i]
					gsub(/^[ \t]+/, "", m)
					sub(/[ \t].*$/, "", m)
					if (m ~ /^[A-Za-z_][A-Za-z0-9_.]*$/) absimp(m)
				}
				next
			}
			if (!match(line, /^[ \t]*from[ \t]+[.A-Za-z0-9_]+[ \t]+import[ \t]+/)) next
			hdr = substr(line, RSTART, RLENGTH)
			rest = substr(line, RLENGTH + 1)
			base = hdr
			sub(/^[ \t]*from[ \t]+/, "", base)
			sub(/[ \t]+import[ \t]+$/, "", base)
			gsub(/[()\\]/, " ", rest)
			n = split(rest, parts, ",")
			for (i = 1; i <= n; i++) {
				nm = parts[i]
				gsub(/^[ \t]+/, "", nm)
				sub(/[ \t].*$/, "", nm)
				names[i] = nm
			}
			if (base !~ /^\./) {
				absimp(base)
				for (i = 1; i <= n; i++) if (names[i] ~ /^[A-Za-z_][A-Za-z0-9_]*$/) absimp(base "." names[i])
				next
			}
			match(base, /^\.+/)
			dots = RLENGTH
			mod = substr(base, dots + 1)
			pdir = dir
			for (k = 1; k < dots; k++) {
				if (pdir == "") { print f US "?" base; next }
				if (sub(/\/[^\/]*$/, "", pdir) == 0) pdir = ""
			}
			prefix = (pdir == "") ? "" : pdir "/"
			gsub(/\./, "/", mod)
			if (mod != "") {
				r = res(prefix mod)
				if (r == "") { print f US "?" base; next }
				emit(r)
				for (i = 1; i <= n; i++) if (names[i] ~ /^[A-Za-z_][A-Za-z0-9_]*$/) emit(res(prefix mod "/" names[i]))
				next
			}
			hit = 0
			for (i = 1; i <= n; i++) {
				if (names[i] !~ /^[A-Za-z_][A-Za-z0-9_]*$/) continue
				r = res(prefix names[i])
				if (r != "") { emit(r); hit = 1 }
			}
			r = res(prefix "__init__")
			if (r != "") { emit(r); hit = 1 }
			if (!hit) print f US "?" base
		}
	' "$cr_files") | sort -u >"$py_edges"
}

# rev_closure prints every node of an edges file that (transitively) reaches
# the start node, the start excluded.
rev_closure() {
	printf '%s\n' "$2" >"$tmp/rc_front"
	printf '%s\n' "$2" >"$tmp/rc_seen"
	while [ -s "$tmp/rc_front" ]; do
		awk -F "$us" 'FNR == NR { want[$0] = 1; next } ($2 in want) { print $1 }' \
			"$tmp/rc_front" "$1" | sort -u | comm -23 - "$tmp/rc_seen" >"$tmp/rc_next"
		cat "$tmp/rc_next" >>"$tmp/rc_seen"
		sort -u "$tmp/rc_seen" -o "$tmp/rc_seen"
		mv "$tmp/rc_next" "$tmp/rc_front"
	done
	grep -Fxv -- "$2" "$tmp/rc_seen" || true
}

# compute_scoped_python selects the unit tests (pytest-collected files outside
# the suite set) that import a changed module, directly or through other
# repository modules, then the carries suites. A changed module no test
# reaches is a low-confidence scope: the full tier.
compute_scoped_python() {
	py_bad=0
	: >"$tmp/py_units"
	while IFS= read -r p; do
		case "$p" in *.py) ;; *) continue ;; esac
		{
			printf '%s\n' "$p"
			rev_closure "$py_edges" "$p"
		} >"$tmp/py_reach"
		found=0
		while IFS= read -r r; do
			is_py_test "$r" || continue
			found=1
			grep -Fxq -- "$r" "$cr_cand" && continue
			[ -f "$root/$r" ] && printf '%s\n' "$r" >>"$tmp/py_units"
		done <"$tmp/py_reach"
		if [ "$found" -eq 0 ]; then
			diag "python: no test imports the changed module $p (directly or through another module); its affected tests cannot be resolved, falling back to the full tier"
			py_bad=1
		fi
	done <"$changed"
	if [ -s "$tmp/py_units" ]; then
		add_scoped "pytest $(sort -u "$tmp/py_units" | tr '\n' ' ' | sed 's/ $//')"
	fi
	carries_scoped || py_bad=1
	[ "$py_bad" -eq 0 ]
}

# ---------------------------------------------------------------------------
# Rust analyzer. The module tree is scanned from `mod <name>;` declarations
# (a crate root — src/lib.rs, src/main.rs, a mod.rs or a top-level tests/*.rs —
# keeps its children beside it, any other module in its own directory); a
# declaration that names no file is unresolvable. A changed module selects the
# unit tests of the modules that contain it or `use` it (`crate::<path>`),
# filtered by module path, plus the carries suites.
# ---------------------------------------------------------------------------
rs_edges="$tmp/rs_edges"
: >"$rs_edges"

# rs_scan writes "<module><US><child module file>" (or "<module><US>?mod
# <name>") for every .rs file of the repository.
rs_scan() {
	: >"$rs_edges"
	grep '\.rs$' "$cr_files" >"$tmp/rs_files" || return 0
	(cd "$root" && tr '\n' '\0' <"$tmp/rs_files" |
		xargs -0 awk -v US="$us" '
		FNR == NR { exists[$0] = 1; next }
		FNR == 1 {
			f = FILENAME
			dir = f
			if (sub(/\/[^\/]*$/, "", dir) == 0) dir = ""
			b = f
			sub(/^.*\//, "", b)
			if (b == "lib.rs" || b == "main.rs" || b == "mod.rs" || f ~ /^tests\/[^\/]*\.rs$/) cdir = dir
			else { cdir = f; sub(/\.rs$/, "", cdir) }
			prefix = (cdir == "") ? "" : cdir "/"
		}
		/^[ \t]*(pub(\([^)]*\))?[ \t]+)?mod[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*;/ {
			name = $0
			sub(/^[ \t]*(pub(\([^)]*\))?[ \t]+)?mod[ \t]+/, "", name)
			sub(/[ \t]*;.*$/, "", name)
			if ((prefix name ".rs") in exists) print f US prefix name ".rs"
			else if ((prefix name "/mod.rs") in exists) print f US prefix name "/mod.rs"
			else print f US "?mod " name
		}
	' "$cr_files") | sort -u >"$rs_edges"
}

# fwd_closure prints every node an edges file reaches from the start node,
# the start included.
fwd_closure() {
	printf '%s\n' "$2" >"$tmp/fc_front"
	printf '%s\n' "$2" >"$tmp/fc_seen"
	while [ -s "$tmp/fc_front" ]; do
		awk -F "$us" 'FNR == NR { want[$0] = 1; next } ($1 in want) && $2 !~ /^\?/ { print $2 }' \
			"$tmp/fc_front" "$1" | sort -u | comm -23 - "$tmp/fc_seen" >"$tmp/fc_next"
		cat "$tmp/fc_next" >>"$tmp/fc_seen"
		sort -u "$tmp/fc_seen" -o "$tmp/fc_seen"
		mv "$tmp/fc_next" "$tmp/fc_front"
	done
	cat "$tmp/fc_seen"
}

# rs_modpath maps a src/ module file to its module path (src/a/b.rs and
# src/a/b/mod.rs are a::b).
rs_modpath() {
	m="${1#src/}"
	m="${m%.rs}"
	m="${m%/mod}"
	printf '%s' "$m" | sed 's#/#::#g'
}

compute_scoped_rust() {
	rs_bad=0
	crate="$(awk '
		/^[ \t]*\[/ { pkg = ($0 ~ /^[ \t]*\[package\][ \t]*$/); next }
		pkg && /^[ \t]*name[ \t]*=/ { v = $0; sub(/^[^=]*=[ \t]*"/, "", v); sub(/".*$/, "", v); print v; exit }
	' "$root/Cargo.toml" 2>/dev/null | tr '-' '_')"
	: >"$tmp/rs_lib"
	: >"$tmp/rs_bin"
	[ -f "$root/src/lib.rs" ] && fwd_closure "$rs_edges" src/lib.rs >"$tmp/rs_lib"
	[ -f "$root/src/main.rs" ] && fwd_closure "$rs_edges" src/main.rs >"$tmp/rs_bin"
	: >"$tmp/rs_lib_filters"
	: >"$tmp/rs_bin_filters"
	while IFS= read -r p; do
		case "$p" in
		*.rs) ;;
		*) continue ;;
		esac
		case "$p" in
		tests/*) continue ;;
		src/lib.rs | src/main.rs)
			diag "rust: the crate root $p changed; its affected tests cannot be narrowed, falling back to the full tier"
			rs_bad=1
			continue
			;;
		esac
		if grep -Fxq -- "$p" "$tmp/rs_lib"; then
			kind="lib"
		elif grep -Fxq -- "$p" "$tmp/rs_bin"; then
			kind="bin"
		else
			diag "rust: the changed file $p is in no crate's module tree (no mod declaration reaches it); its affected tests cannot be resolved, falling back to the full tier"
			rs_bad=1
			continue
		fi
		# The changed module and every module of the same crate that uses it,
		# transitively.
		printf '%s\n' "$p" >"$tmp/rs_set"
		printf '%s\n' "$p" >"$tmp/rs_front"
		while [ -s "$tmp/rs_front" ]; do
			: >"$tmp/rs_next"
			while IFS= read -r q; do
				mp="$(rs_modpath "$q")"
				(cd "$root" && tr '\n' '\0' <"$tmp/rs_$kind" |
					xargs -0 grep -lE "crate::$mp([^A-Za-z0-9_]|\$)" 2>/dev/null) >>"$tmp/rs_next" || true
			done <"$tmp/rs_front"
			sort -u "$tmp/rs_next" | comm -23 - "$tmp/rs_set" >"$tmp/rs_front"
			cat "$tmp/rs_front" >>"$tmp/rs_set"
			sort -u "$tmp/rs_set" -o "$tmp/rs_set"
		done
		found=0
		while IFS= read -r q; do
			mp="$(rs_modpath "$q")"
			if grep -Eq '#\[(test|cfg\(test\))\]' "$root/$q" 2>/dev/null; then
				printf '%s::\n' "$mp" >>"$tmp/rs_${kind}_filters"
				found=1
			fi
			if [ -n "$crate" ] && (cd "$root" && grep '^tests/.*\.rs$' "$cr_files" | tr '\n' '\0' |
				xargs -0 grep -lE "$crate::$mp([^A-Za-z0-9_]|\$)" 2>/dev/null) | grep -q .; then
				found=1
			fi
		done <"$tmp/rs_set"
		if [ "$found" -eq 0 ]; then
			diag "rust: no unit test module or integration test reaches the changed module $p; its affected tests cannot be resolved, falling back to the full tier"
			rs_bad=1
		fi
	done <"$changed"
	if [ -s "$tmp/rs_lib_filters" ]; then
		add_scoped "cargo test --lib -- $(sort -u "$tmp/rs_lib_filters" | tr '\n' ' ' | sed 's/ $//')"
	fi
	if [ -s "$tmp/rs_bin_filters" ]; then
		add_scoped "cargo test --bins -- $(sort -u "$tmp/rs_bin_filters" | tr '\n' ' ' | sed 's/ $//')"
	fi
	carries_scoped || rs_bad=1
	[ "$rs_bad" -eq 0 ]
}

case "$analyzer" in
npm | python | rust)
	cr_list_files
	[ "$analyzer" = "python" ] && py_scan
	[ "$analyzer" = "rust" ] && rs_scan
	carries_discover
	;;
esac

mode="full"
if [ "$full" -eq 0 ]; then
	if [ ! -s "$changed" ]; then
		# Empty diff: scoped with an empty affected set, fast gates only.
		mode="scoped"
	else
		case "$analyzer" in
		go)
			if compute_scoped_go; then mode="scoped"; else full=1; fi
			;;
		npm)
			if compute_scoped_npm; then mode="scoped"; else full=1; fi
			;;
		python)
			if compute_scoped_python; then mode="scoped"; else full=1; fi
			;;
		rust)
			if compute_scoped_rust; then mode="scoped"; else full=1; fi
			;;
		esac
	fi
fi

# ---------------------------------------------------------------------------
# Full-tier e2e selection. A repository opts in by declaring at least one
# smoke_suite=; the caller asked for the full tier (--full) and the diff is
# non-empty. full_tier_selection sets sel_mode and writes the selected suites
# to $tmp/sel_suites and the uncovered paths to $tmp/sel_uncov:
#   full    — a forced-full match (built-in config rules or forced_full=), the
#             conf itself changed, or a structural diagnostic (a carries key
#             or smoke_suite= empty/malformed, an analyzer without the carries
#             layer, an undeclared or malformed suite, an unresolvable import,
#             an e2e_map= or smoke_suite= naming no discovered suite, an empty
#             full tail): the full tail runs, every reason is diagnosed;
#   smoke   — every changed path is documentation or an exclude= match: the
#             smoke suites only;
#   carries — the carries-selected suites union the smoke suites; a changed
#             non-documentation path covered by no declaration is listed as
#             uncovered and does not force the full tail.
# The scoped tier never reaches this: it adds no smoke suite and still sends
# an uncovered path to the full tier.
# ---------------------------------------------------------------------------
sel_fallback() {
	diag "full-tier e2e selection falls back to the full e2e command: $1"
	sel_mode="full"
}

full_tier_selection() {
	sel_mode=""
	[ "$conf_closed" -eq 1 ] && sel_fallback "a carries or smoke_suite key of the conf is empty or malformed"
	case "$analyzer" in
	npm | python | rust) ;;
	*) sel_fallback "the ${analyzer:-absent} analyzer has no carries layer" ;;
	esac
	while IFS= read -r p; do
		[ -n "$p" ] || continue
		path_forced "$p" && sel_fallback "changed path $p is forced full"
	done <"$changed"
	[ "$conf_changed" = "true" ] && sel_fallback "the diff changes .polyforge/verify-scope.conf"
	case "$analyzer" in
	npm | python | rust)
		cr_maperr_diag || sel_fallback "an e2e_map= names no discovered suite"
		cr_structure || sel_fallback "the carries declarations are structurally broken"
		;;
	esac
	while IFS= read -r s; do
		grep -Fxq -- "$s" "$cr_suites" || sel_fallback "smoke_suite $s is not a discovered suite"
	done <"$conf_smoke"
	[ -s "$tmp/sel_full" ] || sel_fallback "the full tail is empty"
	[ "$sel_mode" = "full" ] && return 0
	cr_select
	sel_mode="smoke"
	while IFS= read -r p; do
		[ -n "$p" ] || continue
		is_doc_path "$p" && continue
		path_excluded "$p" && continue
		sel_mode="carries"
		break
	done <"$changed"
	if [ "$sel_mode" = "carries" ]; then
		cat "$tmp/cr_sel" "$conf_smoke" | sort -u >"$tmp/sel_suites"
		cp "$tmp/cr_uncov" "$tmp/sel_uncov"
	else
		sort -u "$conf_smoke" >"$tmp/sel_suites"
	fi
}

# ---------------------------------------------------------------------------
# Commands: fast gates first, then the scoped selection or the full tail.
# ---------------------------------------------------------------------------
: >"$tmp/commands"
fast_scripts="$tmp/fast_scripts"
: >"$fast_scripts"
if [ -s "$conf_fast" ]; then
	add_conf_cmds fast "$conf_fast"
elif [ "$analyzer" = "go" ]; then
	add_cmd fast "GOWORK=off go build ./..."
	add_cmd fast "GOWORK=off go vet ./..."
	add_cmd fast 'test -z "$(gofmt -l .)"'
elif [ "$analyzer" = "npm" ]; then
	if [ ! -d "$root/node_modules" ]; then
		add_cmd fast "npm ci"
	fi
	if npm_has_script lint; then
		add_cmd fast "npm run lint"
		printf 'lint\n' >>"$fast_scripts"
	fi
	if npm_has_typescript; then
		add_cmd fast "node_modules/.bin/tsc --noEmit"
	fi
	if npm_has_script test; then
		add_cmd fast "npm test"
		printf 'test\n' >>"$fast_scripts"
	fi
elif [ "$analyzer" = "python" ]; then
	add_cmd fast "python -m compileall -q"
elif [ "$analyzer" = "rust" ]; then
	add_cmd fast "cargo build --all-targets"
fi

sel_mode=""
: >"$tmp/sel_suites"
: >"$tmp/sel_uncov"
: >"$tmp/sel_full"
if [ "$micro" -eq 1 ]; then
	mode="micro"
	add_conf_cmds micro "$conf_micro"
	[ -s "$conf_micro_path" ] || diag "--micro: the conf at the diff base declares no micro_path (the repository is not opted in)"
elif [ "$mode" = "full" ]; then
	fast_count="$(wc -l <"$tmp/commands" | tr -d ' ')"
	if [ -s "$conf_full" ]; then
		add_conf_cmds full "$conf_full"
	elif [ "$analyzer" = "go" ]; then
		add_cmd full "GOWORK=off go test -count=1 ./..."
	elif [ "$analyzer" = "npm" ]; then
		suite_refs="$tmp/suite_refs"
		npm_script_suites >"$tmp/script_suites"
		cut -f2 "$tmp/script_suites" | sed 's#^e2e/##' | sort -u >"$suite_refs"
		# Report each declared script that runs an e2e/*.mjs suite; the fast-gate
		# scripts already ran and are not repeated.
		cut -f1 "$tmp/script_suites" | sort -u | while IFS= read -r name; do
			[ -n "$name" ] || continue
			grep -Fxq -- "$name" "$fast_scripts" && continue
			add_cmd full "npm run $name"
		done
		# Remaining suites (the carries layer's suite set: no imported helper,
		# no exclude= match, no e2e_runner= target), not already run by a
		# script.
		while IFS= read -r s; do
			case "$s" in
			e2e/*) grep -Fxq -- "${s#e2e/}" "$suite_refs" && continue ;;
			esac
			add_cmd full "$(cr_suite_cmd "$s")"
		done <"$cr_suites"
	elif [ "$analyzer" = "python" ]; then
		add_cmd full "pytest"
	elif [ "$analyzer" = "rust" ]; then
		add_cmd full "cargo test"
	fi
	# The full tail is the carried full e2e bar and the selection's fallback.
	tail -n +"$((fast_count + 1))" "$tmp/commands" | cut -d "$us" -f4- >"$tmp/sel_full"
	if [ "$force_full" -eq 1 ] && [ "$smoke_declared" -eq 1 ] && [ -s "$changed" ]; then
		full_tier_selection
		if [ "$sel_mode" != "full" ]; then
			head -n "$fast_count" "$tmp/commands" >"$tmp/commands.fast"
			mv "$tmp/commands.fast" "$tmp/commands"
			cr_suite_cmds "$tmp/sel_suites" >"$tmp/sel_cmds"
			while IFS= read -r c; do
				add_cmd full "$c"
			done <"$tmp/sel_cmds"
		fi
	fi
else
	while IFS= read -r c; do
		add_cmd scoped "$c"
	done <"$tmp/scoped_cmds"
fi

# Name the analyzer-default commands <phase>-<i> in report order. A phase's
# conf lines replace its defaults, so the two never share a phase.
awk -F "$us" -v OFS="$us" '$1 == "" { n[$2]++; $1 = $2 "-" n[$2] } { print }' \
	"$tmp/commands" >"$tmp/commands.named"
mv "$tmp/commands.named" "$tmp/commands"

# emit_json prints the report as exactly one JSON object (schema 1). python3
# runs isolated (-I), so nothing in the target repository is imported.
emit_json() {
	python3 -I - "$tmp" "$root" "$stack" "$analyzer" "$conf_state" "$conf_changed" \
		"$base_sha" "$head_sha" "$default" "$mode" "$conf_runner" "$conf_e2e_runner" "$sel_mode" "$smoke_declared" \
		"$micro" <<'PY'
import json
import sys

(tmp, root, stack, analyzer, conf, conf_changed, base, head, default,
 mode, runner, e2e_runner, sel_mode, smoke_declared, micro) = sys.argv[1:16]
US = "\x1f"


def lines(name):
    try:
        with open(tmp + "/" + name, "rb") as f:
            data = f.read().decode("utf-8", "replace")
    except FileNotFoundError:
        return []
    return [ln for ln in data.split("\n") if ln != ""]


def bound(name):
    out = {}
    for ln in lines(name):
        key, _, val = ln.partition(US)
        vals = out.setdefault(key, [])
        if val not in vals:
            vals.append(val)
    return out


req_env = bound("conf_req_env")
req_cmd = bound("conf_req_cmd")
# An undeclared timeout is null: the consumer's own default applies.
timeouts = {key: vals[0] for key, vals in bound("conf_timeout").items()}
commands = []
for ln in lines("commands"):
    name, phase, source, cmd = ln.split(US, 3)
    commands.append({
        "name": name,
        "phase": phase,
        "cmd": cmd,
        "requires_env": req_env.get(name, []),
        "requires_cmd": req_cmd.get(name, []),
        "timeout": timeouts.get(name),
        "source": source,
    })
report = {
    "schema": 1,
    "root": root,
    "stack": stack,
    "analyzer": analyzer or None,
    "conf": conf,
    "conf_changed_in_diff": conf_changed == "true",
    "base": base or None,
    "head": head or None,
    "default_branch": default,
    "mode": mode,
    "paths": lines("changed"),
    "commands": commands,
    "test_glob": lines("conf_globs"),
    "base_setup": lines("conf_base_setup"),
    "runner": runner or None,
    "ci_evidence": lines("conf_ci"),
    "e2e_runner": e2e_runner or None,
    "suite_glob": lines("conf_suite_glob"),
    "e2e_map": lines("conf_e2e_map"),
    "diagnostics": lines("diag"),
}
# An opted-in repository (any smoke_suite= line) reports its smoke suites and
# the full-tier selection (null when none was attempted); a repository that
# declares none keeps the report's key set unchanged.
if smoke_declared == "1":
    report["smoke_suite"] = lines("conf_smoke")
    report["e2e_selection"] = {
        "mode": sel_mode,
        "suites": lines("sel_suites"),
        "uncovered_paths": lines("sel_uncov"),
        "full_commands": lines("sel_full"),
    } if sel_mode else None
# A repository that declares micro_path= or micro_check= (and every --micro
# report) echoes the micro declaration; one that declares neither keeps the
# report's key set unchanged.
micro_checks = [ln.partition(US)[2] for ln in lines("conf_micro")]
if micro == "1" or lines("conf_micro_path") or micro_checks:
    report["micro_paths"] = lines("conf_micro_path")
    report["micro_checks"] = micro_checks
sys.stdout.write(json.dumps(report, indent=2, ensure_ascii=True) + "\n")
PY
}

if [ "$json" -eq 1 ]; then
	if ! emit_json; then
		echo "verify-scope: cannot emit the JSON report" >&2
		exit 1
	fi
else
	printf 'mode: %s\n' "$mode"
	while IFS= read -r p; do
		printf 'path: %s\n' "$p"
	done <"$changed"
	while IFS="$us" read -r cn _ _ c; do
		printf 'command: %s\n' "$c"
	done <"$tmp/commands"
fi

# run_missing prints a command's missing declared prerequisites (an unset or
# empty variable, an executable not on PATH), comma-separated.
run_missing() {
	missing=""
	while IFS="$us" read -r rn rv; do
		[ "$rn" = "$1" ] || continue
		[ -n "$(printenv "$rv" 2>/dev/null)" ] && continue
		missing="${missing:+$missing, }env $rv"
	done <"$conf_req_env"
	while IFS="$us" read -r rn rv; do
		[ "$rn" = "$1" ] || continue
		command -v "$rv" >/dev/null 2>&1 && continue
		missing="${missing:+$missing, }command $rv"
	done <"$conf_req_cmd"
	printf '%s' "$missing"
}

if [ "$run" -eq 1 ]; then
	if [ "$micro" -eq 1 ]; then
		if [ ! -s "$conf_micro_path" ]; then
			echo "verify-scope: --micro --run: the repository declares no micro_path at the diff base" >&2
			exit 1
		fi
		if [ ! -s "$tmp/commands" ]; then
			echo "verify-scope: --micro --run: no fast-phase or micro_check command to run" >&2
			exit 1
		fi
	fi
	while IFS="$us" read -r cn _ _ c; do
		missing="$(run_missing "$cn")"
		if [ -n "$missing" ]; then
			if [ "$micro" -eq 1 ]; then
				echo "verify-scope: --micro --run: $cn is missing $missing (a skipped micro check is a failure): $c" >&2
				exit 1
			fi
			echo "verify-scope: skipped $cn (missing $missing): $c" >&2
			continue
		fi
		if ! (cd "$root" && bash -c "$c" 1>&2 </dev/null); then
			echo "verify-scope: reported command failed: $c" >&2
			exit 1
		fi
	done <"$tmp/commands"
fi
