{
  "name": "@silgrid/pi-web",
  "version": "0.2.0-dev.0",
  "description": "Fork of @agegr/pi-web: local web UI for the pi coding agent with split-pane chat and background task panels",
  "homepage": "https://github.com/silgrid/polyforge/tree/main/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silgrid/polyforge.git",
    "directory": "pi-web"
  },
  "bugs": {
    "url": "https://github.com/silgrid/polyforge/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js",
    "pi-web-deploy": "bin/pi-web-deploy.js"
  },
  "imports": {
    "#test-env": "./scripts/test-env-setup.mjs"
  },
  "files": [
    "bin",
    "deploy-piweb.sh",
    "THIRD_PARTY_NOTICES.md",
    "patches",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/e2e",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "postinstall": "patch-package && node bin/prepare-terminal.js",
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e:all": "node e2e/all.mjs",
    "test:e2e": "node --experimental-strip-types e2e/run.mjs",
    "test": "node scripts/tmp-guard.mjs node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"docs/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\" \"e2e/runner/**/*.test.mjs\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "^5.4.1",
    "next": "16.4.4",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.5",
    "typebox": "1.3.27",
    "undici": "8.12.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.6",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "ansi_up": "^6.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
