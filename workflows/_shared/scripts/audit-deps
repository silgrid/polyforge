#!/bin/sh
# audit-deps — release-shipped inbound dependency-vulnerability audit gate.
#
# Usage:
#   workflows/_shared/scripts/audit-deps [--go] [--npm <dir>]... [--ledger <path>]
#
# verify-scope (beside it) appends this gate, as the full-phase command named
# `audit`, to every full-tier report of a repository that carries an
# auditable dependency tree (docs/contributing.md "Verification tiers"). The
# current directory is the engine root — the repository root, or a nested
# engine root, for which verify-scope passes the repository's ledger at the
# top of the git work tree as --ledger; each flag names one surface:
#
#   --go          GOWORK=off govulncheck -json ./...  (symbol mode: only a
#                 vulnerability reached through a called symbol is a finding;
#                 an imported-but-unreached package is not)
#   --npm <dir>   npm audit --json --audit-level=high --package-lock-only
#                 --include=dev, run in <dir> (repository-relative): the
#                 whole lockfile tree, dev dependencies included; a high or
#                 critical advisory is a finding, moderate and low are not
#   --ledger <p>  the exemption ledger (default .polyforge/audit-exemptions.conf
#                 in the current directory; an absent file exempts nothing)
#
# Ledger rows (docs/reference/config.md "Dependency-audit exemptions"):
#
#   exempt=<advisory>|<package>|<reason>|<owner-ruling>|<from>|<expires>
#
# A finding is exempt only when a valid row names its advisory id and package
# and today (UTC) is no later than the row's expiry. Diagnostics go to stderr,
# one per line, each starting with its cause:
#
#   tool-missing:    an audit tool (npm, go, govulncheck, python3) is absent
#   db-unreachable:  the advisory source could not be reached
#   finding:         an unexempted finding (advisory, package, surface)
#   ledger-invalid:  a malformed row (never honoured)
#   ledger-expired:  a row past its expiry (never honoured)
#   stale:           a valid row that matches no current finding
#   surface <name>:  the per-surface summary (npm:<dir> or go:.)
#   audit-deps:      any other failure (a tool's unexpected error)
#
# Exit 0 only when every surface was audited, no unexempted finding remains
# and every ledger row is valid; otherwise exit 1 (2 on a usage error). A
# missing tool, an unreachable advisory source or a tool error is red, never
# a skip. stale: and ledger-expired: alone never turn the gate red.
#
# The gate has no switch that disables, narrows or relaxes it.

set -u
export LC_ALL=C

usage() {
	echo "usage: workflows/_shared/scripts/audit-deps [--go] [--npm <dir>]... [--ledger <path>]" >&2
}

tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM
: >"$tmp/surfaces"
ledger=".polyforge/audit-exemptions.conf"
n=0
while [ $# -gt 0 ]; do
	case "$1" in
	--go)
		n=$((n + 1))
		printf '%s\tgo\t.\n' "$n" >>"$tmp/surfaces"
		shift
		;;
	--npm | --ledger)
		[ $# -ge 2 ] && [ -n "$2" ] || {
			echo "audit-deps: $1 needs a value" >&2
			usage
			exit 2
		}
		if [ "$1" = "--npm" ]; then
			n=$((n + 1))
			printf '%s\tnpm\t%s\n' "$n" "$2" >>"$tmp/surfaces"
		else
			ledger="$2"
		fi
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "audit-deps: unknown argument '$1'" >&2
		usage
		exit 2
		;;
	esac
done
[ "$n" -gt 0 ] || {
	echo "audit-deps: no surface to audit (--go or --npm <dir>)" >&2
	usage
	exit 2
}
command -v python3 >/dev/null 2>&1 || {
	echo "tool-missing: python3 is not on PATH; the audit gate cannot evaluate any surface (install python3)" >&2
	exit 1
}

# Run each surface's tool; its stdout, stderr and exit status are kept for the
# evaluation below. A missing tool or directory is recorded, never skipped.
: >"$tmp/runs"
while IFS="$(printf '\t')" read -r i kind dir; do
	state="ran"
	if [ "$kind" = "go" ]; then
		for tool in go govulncheck; do
			command -v "$tool" >/dev/null 2>&1 || {
				state="tool-missing:$tool"
				break
			}
		done
		if [ "$state" = "ran" ]; then
			GOWORK=off govulncheck -json ./... >"$tmp/$i.out" 2>"$tmp/$i.err" </dev/null
			state="ran:$?"
		fi
	else
		if ! command -v npm >/dev/null 2>&1; then
			state="tool-missing:npm"
		elif [ ! -d "$dir" ]; then
			state="no-dir"
		else
			(cd "$dir" && npm audit --json --audit-level=high --package-lock-only --include=dev) \
				>"$tmp/$i.out" 2>"$tmp/$i.err" </dev/null
			state="ran:$?"
		fi
	fi
	printf '%s\t%s\t%s\t%s\n' "$i" "$kind" "$dir" "$state" >>"$tmp/runs"
done <"$tmp/surfaces"

python3 -I - "$tmp" "$ledger" <<'PY'
import datetime
import json
import re
import sys

tmp, ledger_path = sys.argv[1:3]
today = datetime.datetime.now(datetime.timezone.utc).date()
red = False

HINT = {
    "npm": "install Node.js with npm",
    "go": "install the Go toolchain",
    "govulncheck": "go install golang.org/x/vuln/cmd/govulncheck@v1.9.0",
}
# Network and advisory-service failures as the tools themselves word them.
UNREACHABLE = re.compile(
    r"ECONNREFUSED|ENOTFOUND|ETIMEDOUT|EAI_AGAIN|ECONNRESET|EHOSTUNREACH|"
    r"ENETUNREACH|socket hang up|request to \S+ failed|audit endpoint returned "
    r"an error|fetching vulnerabilities|proxyconnect|dial tcp|no such host|"
    r"i/o timeout|TLS handshake|connection refused")
ADVISORY = re.compile(r"^(GHSA(-[23456789cfghjmpqrvwx]{4}){3}|GO-[0-9]{4}-[0-9]{4,})$")
DATE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
FIELDS = ("advisory", "package", "reason", "owner-ruling", "from", "expires")


def say(line):
    sys.stderr.write(line + "\n")


def read(name):
    try:
        with open(tmp + "/" + name, "rb") as f:
            return f.read().decode("utf-8", "replace")
    except FileNotFoundError:
        return ""


def last_line(text):
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    return lines[-1] if lines else "(no output)"


def npm_findings(out, err):
    """Answer (findings, failure): findings are (advisory, package, detail)."""
    try:
        report = json.loads(out)
    except ValueError:
        report = None
    if not isinstance(report, dict):
        if UNREACHABLE.search(err):
            return None, ("db-unreachable", last_line(err))
        return None, ("audit-deps", "npm audit printed no JSON report: " + last_line(err))
    if "vulnerabilities" not in report or "error" in report:
        text = json.dumps(report.get("message", "")) + json.dumps(report.get("error", "")) + "\n" + err
        cause = "db-unreachable" if UNREACHABLE.search(text) else "audit-deps"
        msg = report.get("message") or (report.get("error") or {}).get("summary") or last_line(err)
        return None, (cause, "npm audit: " + str(msg))
    found = {}
    for vuln in report["vulnerabilities"].values():
        for via in vuln.get("via", []):
            if not isinstance(via, dict) or via.get("severity") not in ("high", "critical"):
                continue
            url = str(via.get("url", ""))
            adv = url.rsplit("/", 1)[-1] or str(via.get("source", ""))
            pkg = str(via.get("name", ""))
            found.setdefault((adv, pkg), "%s %s" % (via.get("severity"), url))
    return found, None


def go_findings(out, err, rc):
    if rc != 0:
        cause = "db-unreachable" if UNREACHABLE.search(err) else "audit-deps"
        return None, (cause, "govulncheck exit %d: %s" % (rc, last_line(err)))
    dec = json.JSONDecoder()
    pos, events = 0, []
    try:
        while True:
            while pos < len(out) and out[pos].isspace():
                pos += 1
            if pos >= len(out):
                break
            obj, pos = dec.raw_decode(out, pos)
            events.append(obj)
    except ValueError:
        return None, ("audit-deps", "govulncheck printed an unreadable JSON stream")
    if not any(isinstance(e, dict) and "config" in e for e in events):
        return None, ("audit-deps", "govulncheck printed no scan report: " + last_line(err))
    found = {}
    for e in events:
        f = e.get("finding") if isinstance(e, dict) else None
        if not f:
            continue
        trace = f.get("trace") or [{}]
        # Symbol mode: only a finding whose innermost frame names a function
        # is reachable; module- and package-level findings are import-only.
        if not trace[0].get("function"):
            continue
        key = (str(f.get("osv", "")), str(trace[0].get("module", "")))
        found.setdefault(key, "reachable via %s.%s" % (trace[0].get("package", ""), trace[0]["function"]))
    return found, None


# Run every surface's evaluation.
findings = []  # (surface, advisory, package, detail)
audited_all = True
for ln in read("runs").splitlines():
    i, kind, d, state = ln.split("\t")
    name = "%s:%s" % (kind, d)
    if state.startswith("tool-missing:"):
        tool = state.split(":", 1)[1]
        say("tool-missing: %s is not on PATH; surface %s was not audited (%s)" % (tool, name, HINT[tool]))
        red, audited_all = True, False
        continue
    if state == "no-dir":
        say("audit-deps: surface %s: no such directory" % name)
        red, audited_all = True, False
        continue
    rc = int(state.split(":", 1)[1])
    out, err = read(i + ".out"), read(i + ".err")
    if kind == "npm":
        found, failure = npm_findings(out, err)
    else:
        found, failure = go_findings(out, err, rc)
    if failure:
        cause, msg = failure
        say("%s: surface %s was not audited: %s" % (cause, name, msg))
        red, audited_all = True, False
        continue
    for (adv, pkg), detail in sorted(found.items()):
        findings.append((name, adv, pkg, detail))
    say("surface %s: audited, %d finding(s) before exemptions" % (name, len(found)))

# The ledger: one exempt= row per exemption; an absent file exempts nothing.
rows = []  # (line number, advisory, package)
try:
    with open(ledger_path, "rb") as f:
        ledger = f.read().decode("utf-8", "replace").splitlines()
except FileNotFoundError:
    ledger = []
for no, raw in enumerate(ledger, 1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    where = "%s:%d" % (ledger_path, no)
    if not line.startswith("exempt="):
        say("ledger-invalid: %s: not an exempt= row" % where)
        red = True
        continue
    vals = [v.strip() for v in line[len("exempt="):].split("|")]
    if len(vals) != len(FIELDS):
        say("ledger-invalid: %s: %d fields, a row has exactly %d (%s)" % (where, len(vals), len(FIELDS), "|".join(FIELDS)))
        red = True
        continue
    row = dict(zip(FIELDS, vals))
    problem = ""
    empty = [k for k in FIELDS if not row[k]]
    dates = {}
    if empty:
        problem = "missing " + ", ".join(empty)
    elif not ADVISORY.match(row["advisory"]):
        problem = "advisory %r is not a GHSA- or GO- identifier" % row["advisory"]
    else:
        for k in ("from", "expires"):
            try:
                if not DATE.match(row[k]):
                    raise ValueError
                dates[k] = datetime.date.fromisoformat(row[k])
            except ValueError:
                problem = "%s %r is not a YYYY-MM-DD date" % (k, row[k])
                break
    if not problem:
        if dates["from"] > today:
            problem = "from %s is in the future" % row["from"]
        elif dates["expires"] < dates["from"]:
            problem = "expires %s is before from %s" % (row["expires"], row["from"])
        elif (dates["expires"] - dates["from"]).days > 90:
            problem = "expires %s is more than 90 days after from %s" % (row["expires"], row["from"])
    if problem:
        say("ledger-invalid: %s: %s (the row is not honoured)" % (where, problem))
        red = True
        continue
    if dates["expires"] < today:
        say("ledger-expired: %s: %s|%s expired on %s (the row is not honoured)" % (where, row["advisory"], row["package"], row["expires"]))
        continue
    rows.append((where, row["advisory"], row["package"]))

valid = {(adv, pkg) for _, adv, pkg in rows}
used = set()
for name, adv, pkg, detail in findings:
    if (adv, pkg) in valid:
        used.add((adv, pkg))
        continue
    say("finding: surface %s: %s in %s (%s)" % (name, adv, pkg, detail))
    red = True
# A stale row is only knowable when every surface was audited.
if audited_all:
    for where, adv, pkg in rows:
        if (adv, pkg) not in used:
            say("stale: %s: %s|%s matches no current finding (remove the row)" % (where, adv, pkg))
sys.exit(1 if red else 0)
PY
